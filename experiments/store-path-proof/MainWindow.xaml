<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="StorePathProof.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VaultKind Store Path Test">
    <Grid Background="#17191B">
        <StackPanel
            Width="620"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="18">
            <TextBlock
                Text="Microsoft Store path test"
                Foreground="#F5F7FA"
                FontSize="36"
                FontWeight="SemiBold"
                TextAlignment="Center" />
            <TextBlock
                Text="Hello, World. This isolated WinUI 3 package uses VaultKind's Windows App SDK and manual MSIX packaging approach."
                Foreground="#C8CDD3"
                FontSize="19"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <TextBlock
                x:Name="VersionText"
                Foreground="#78B7FF"
                FontSize="18"
                FontWeight="SemiBold"
                TextAlignment="Center" />
            <Border
                Padding="18"
                Background="#202B35"
                BorderBrush="#3096E8"
                BorderThickness="1"
                CornerRadius="10">
                <TextBlock
                    Text="If this window opens from the packaged build, the local package architecture is working."
                    Foreground="#DCEEFF"
                    FontSize="16"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </Grid>
</Window>
