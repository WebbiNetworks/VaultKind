                                    <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{StaticResource BrandBlueBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Choose an encrypted vault file" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
