                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="New password" FontSize="15" />
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><PasswordBox x:Name="ChangeNewPassword" PasswordRevealMode="Hidden" PasswordChanged="ChangePasswordFormChanged" KeyDown="ChangePasswordKeyDown" AutomationProperties.Name="New vault password" /><Button Grid.Column="1" Width="46" Tag="ChangeNewPassword" Click="TogglePasswordVisibility" AutomationProperties.Name="Show new vault password"><FontIcon Glyph="&#xE890;" /></Button></Grid>
                                    </StackPanel>
                                    <StackPanel Spacing="7">
                                        <TextBlock Text="Confirm new password" FontSize="15" />
                                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><PasswordBox x:Name="ChangeConfirmPassword" PasswordRevealMode="Hidden" PasswordChanged="ChangePasswordFormChanged" KeyDown="ChangePasswordKeyDown" AutomationProperties.Name="Confirm new vault password" /><Button Grid.Column="1" Width="46" Tag="ChangeConfirmPassword" Click="TogglePasswordVisibility" AutomationProperties.Name="Show confirmed vault password"><FontIcon Glyph="&#xE890;" /></Button></Grid>
                                        <TextBlock x:Name="ChangePasswordMatchStatus" Text="Use at least 8 characters." TextWrapping="Wrap" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite" />
                                    </StackPanel>
                                    <CheckBox x:Name="ChangePasswordAcknowledge" Content="I understand VaultKind cannot recover a forgotten password" Checked="ChangePasswordFormChanged" Unchecked="ChangePasswordFormChanged" />
                                    <TextBlock x:Name="ChangePasswordStatus" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <ProgressRing x:Name="ChangePasswordProgress" Width="22" Height="22" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" AutomationProperties.Name="Changing vault password" />
                                        <Button Grid.Column="1" Content="Cancel" Padding="20,9" Click="HideManagedChangePassword" />
                                        <Button x:Name="ChangePasswordSubmitButton" Grid.Column="2" Content="Change Password" Padding="22,9" Background="#287FE5" Click="SubmitManagedChangePassword" IsEnabled="False" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel x:Name="ChangePasswordSuccess" Visibility="Collapsed" Spacing="14" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE73E;" FontSize="46" Foreground="#49CD70" />
                                    <TextBlock Text="Password changed" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Text="Your vault now uses the new password. The previous master-key file was preserved as a protected backup." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620" Foreground="{StaticResource MutedTextBrush}" />
                                    <Button x:Name="ChangePasswordDoneButton" Content="Done" HorizontalAlignment="Center" Padding="24,9" Background="#287FE5" Click="HideManagedChangePassword" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="VaultRecoveryKeyDisplay" MaxWidth="900" HorizontalAlignment="Stretch" Visibility="Collapsed" Spacing="18">
                        <Button Content="&#x2039; Back to Vault Management" HorizontalAlignment="Left" Padding="18,8" Click="HideManagedRecoveryKey" />
                        <Border Background="{StaticResource DeepSurfaceBrush}" BorderBrush="{StaticResource StrongDividerBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
                            <StackPanel Spacing="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource IconSurfaceBrush}">
                                        <FontIcon Glyph="&#xE8D7;" FontSize="27" Foreground="{StaticResource BrandBlueBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="View your recovery key" FontSize="25" FontWeight="SemiBold" />
