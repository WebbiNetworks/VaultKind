                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="10">
                                    <FontIcon Glyph="&#xE192;" Foreground="{StaticResource BrandBlueBrush}" FontSize="28" HorizontalAlignment="Left" />
                                    <TextBlock Text="2. Send the password separately" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Use a different trusted channel. Do not put the password in the same message, shared folder, or link as the vault." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE72A;" Foreground="{StaticResource BrandBlueBrush}" FontSize="25" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="What the other person does" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="They install VaultKind, choose Add Vault, select Connect an existing vault, and choose the shared vault folder." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#3B341D" BorderBrush="#D6A900" BorderThickness="1" CornerRadius="10" Padding="18,14">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7BA;" Foreground="#FFC107" FontSize="22" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="4">
                                    <TextBlock Text="Before you share" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="Anyone with both the encrypted vault and its password can unlock its contents. Only share with people you trust." TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="#1E3829" BorderBrush="#268B45" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <TextBlock Text="🔒  This guidance is built into VaultKind. No browser or online service is required." TextWrapping="Wrap" Foreground="#B9EAC7" />
                        </Border>
                        <TextBlock x:Name="ShareVaultStatus" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <StackPanel x:Name="VaultChangePassword" MaxWidth="900" HorizontalAlignment="Stretch" Visibility="Collapsed" Spacing="18">
                        <Button Content="&#x2039; Back to Vault Management" HorizontalAlignment="Left" Padding="18,8" Click="HideManagedChangePassword" />
                        <Border Background="{StaticResource DeepSurfaceBrush}" BorderBrush="{StaticResource StrongDividerBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
                            <StackPanel Spacing="20">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
