                                    </Border>
                                    <Button Content="Done" HorizontalAlignment="Right" Padding="24,9" Background="#287FE5" Click="HideManagedRecoveryKey" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="VaultStatisticsPanel" MaxWidth="1120" HorizontalAlignment="Stretch" Visibility="Collapsed" Spacing="18">
                        <Button Content="&#x2039; Back to Vault" HorizontalAlignment="Left" Padding="18,8" Click="HideVaultStatistics" />
                        <Grid ColumnSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource IconSurfaceBrush}">
                                <FontIcon Glyph="&#xE9D9;" FontSize="27" Foreground="{StaticResource BrandBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Vault Statistics" FontSize="27" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="VaultStatisticsSubtitle" Text="Current local activity for this open vault." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <Button x:Name="RefreshVaultStatisticsButton" Grid.Column="2" Content="Refresh" Padding="18,8" VerticalAlignment="Center" Click="RefreshVaultStatistics" />
                        </Grid>

                        <Grid ColumnSpacing="12" RowSpacing="12">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="StatisticsMetricColumn2" Width="*" /><ColumnDefinition x:Name="StatisticsMetricColumn3" Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="5"><TextBlock x:Name="StatsCacheHitRate" Text="0%" FontSize="25" HorizontalAlignment="Center" /><TextBlock Text="Cache hit rate" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" /></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="5"><TextBlock x:Name="StatsReadRate" Text="0 B/s" FontSize="25" HorizontalAlignment="Center" /><TextBlock Text="Read now" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" /></StackPanel>
                            </Border>
                            <Border x:Name="StatisticsWriteCard" Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="5"><TextBlock x:Name="StatsWriteRate" Text="0 B/s" FontSize="25" HorizontalAlignment="Center" /><TextBlock Text="Write now" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" /></StackPanel>
                            </Border>
                            <Border x:Name="StatisticsAccessCard" Grid.Column="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <StackPanel Spacing="5"><TextBlock x:Name="StatsTotalAccesses" Text="0" FontSize="25" HorizontalAlignment="Center" /><TextBlock Text="Total accesses" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" /></StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{StaticResource DeepSurfaceBrush}" BorderBrush="{StaticResource StrongDividerBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Session totals" FontSize="20" FontWeight="SemiBold" />
                                <Grid ColumnSpacing="16" RowSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Spacing="3"><TextBlock Text="Data read" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="StatsTotalRead" Text="0 B" FontSize="18" /></StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Data written" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="StatsTotalWritten" Text="0 B" FontSize="18" /></StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="3"><TextBlock Text="Data decrypted" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="StatsTotalDecrypted" Text="0 B" FontSize="18" /></StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3"><TextBlock Text="Data encrypted" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="StatsTotalEncrypted" Text="0 B" FontSize="18" /></StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="VaultStatisticsProgress" Width="20" Height="20" Visibility="Collapsed" AutomationProperties.Name="Reading vault statistics" />
                            <TextBlock x:Name="VaultStatisticsStatus" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="VaultLocateEncryptedFilePanel" MaxWidth="1120" HorizontalAlignment="Stretch" Visibility="Collapsed" Spacing="18">
                        <Button Content="&#x2039; Back to Vault" HorizontalAlignment="Left" Padding="18,8" Click="HideLocateEncryptedFile" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource IconSurfaceBrush}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="27" Foreground="{StaticResource BrandBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Locate Encrypted File" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock x:Name="LocateEncryptedFileSubtitle" Text="Find the encrypted storage entry behind a readable file." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                            <Grid ColumnSpacing="18">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource IconSurfaceBrush}">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{StaticResource BrandBlueBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="Choose a file from the open drive" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="VaultKind will identify its matching encrypted storage entry without opening, changing, or uploading the file." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                                <StackPanel x:Name="LocatePickerActions" Grid.Column="2" VerticalAlignment="Center" Spacing="8">
                                    <Button Content="1. Open Readable Drive" Padding="18,8" HorizontalAlignment="Stretch" Click="OpenReadableDriveForLocate" AutomationProperties.Name="Open this vault's readable Windows drive" />
                                    <Button x:Name="ChooseReadableFileButton" Content="2. Choose File..." Padding="18,8" HorizontalAlignment="Stretch" Background="#287FE5" Foreground="White" Click="ChooseReadableFileToLocate" AutomationProperties.Name="Choose a normal file from the readable vault drive" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;" Foreground="{StaticResource BrandBlueBrush}" FontSize="19" VerticalAlignment="Top" Margin="0,2,0,0" />
                                <TextBlock x:Name="LocateReadableDriveHint" Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}" />
                            </Grid>
                        </Border>

                        <Border x:Name="LocateEncryptedFileResult" Visibility="Collapsed" Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                            <StackPanel Spacing="14">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Readable file" Foreground="{StaticResource InfoTextBrush}" />
                                    <TextBlock x:Name="LocatedReadableFileNameText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Encrypted storage entry" Foreground="{StaticResource InfoTextBrush}" />
                                    <TextBlock x:Name="LocatedEncryptedFilePathText" FontFamily="Consolas" FontSize="15" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="LocateResultActions" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                    <Button x:Name="CopyLocatedEncryptedPathButton" Content="Copy Encrypted Path" Padding="16,8" Click="CopyLocatedEncryptedPath" AutomationProperties.Name="Copy the encrypted storage path" />
                                    <Button Content="Open Containing Folder" Padding="16,8" Click="OpenLocatedEncryptedFolder" AutomationProperties.Name="Open the encrypted entry's containing folder" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing x:Name="LocateEncryptedFileProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" VerticalAlignment="Center" AutomationProperties.Name="Locating encrypted file" />
                            <Border x:Name="LocateEncryptedFileStatusBorder"
                                    Grid.Column="1"
                                    Background="{StaticResource InfoSurfaceBrush}"
                                    BorderBrush="{StaticResource InfoBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="14,10"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="LocateEncryptedFileStatus" TextWrapping="WrapWholeWords" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                            </Border>
                        </Grid>

                        <Border Background="#1E3829" BorderBrush="#268B45" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <TextBlock Text="This lookup stays on your computer. VaultKind does not read the file's contents or send either path anywhere." TextWrapping="Wrap" Foreground="#B9EAC7" />
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="VaultDecryptFileNamePanel" MaxWidth="1120" HorizontalAlignment="Stretch" Visibility="Collapsed" Spacing="18">
                        <Button Content="&#x2039; Back to Vault" HorizontalAlignment="Left" Padding="18,8" Click="HideDecryptFileName" />
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource IconSurfaceBrush}">
                                <FontIcon Glyph="&#xE8B7;" FontSize="27" Foreground="{StaticResource BrandBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Decrypt File Name" FontSize="27" FontWeight="SemiBold" />
                                <TextBlock x:Name="DecryptFileNameSubtitle" Text="Translate an encrypted .c9r file name through this open vault." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </Grid>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
