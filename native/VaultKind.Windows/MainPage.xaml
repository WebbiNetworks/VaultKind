                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border x:Name="PasswordStrengthOne" Grid.Column="0" Height="5" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                                    <Border x:Name="PasswordStrengthTwo" Grid.Column="1" Height="5" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                                    <Border x:Name="PasswordStrengthThree" Grid.Column="2" Height="5" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                                    <Border x:Name="PasswordStrengthFour" Grid.Column="3" Height="5" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                                </Grid>
                                <TextBlock x:Name="CreateVaultPasswordStrength" Text="Use at least 8 characters" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="13" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Text="Confirm the new password" FontSize="16" Margin="0,5,0,0" />
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><PasswordBox x:Name="CreateVaultPasswordConfirmInput" PasswordRevealMode="Hidden" PasswordChanged="CreateVaultPasswordChanged" KeyDown="CreateVaultPasswordKeyDown" AutomationProperties.Name="Confirm new vault password" /><Button Grid.Column="1" Width="46" Tag="CreateVaultPasswordConfirmInput" Click="TogglePasswordVisibility" AutomationProperties.Name="Show confirmed vault password"><FontIcon Glyph="&#xE890;" /></Button></Grid>
                                <TextBlock x:Name="CreateVaultPasswordMatchStatus" Text="" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22,14">
                            <StackPanel Spacing="7">
                                <TextBlock Text="Recovery option" FontSize="13" />
                                <TextBlock Text="A recovery key can restore access if you forget your password." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" />
                                <RadioButton x:Name="CreateRecoveryKeyOption" GroupName="CreateVaultRecovery" Content="Create a recovery key (recommended)" FontSize="16" Checked="CreateVaultRecoveryChanged" />
                                <RadioButton x:Name="CreateWithoutRecoveryKeyOption" GroupName="CreateVaultRecovery" Content="Continue without a recovery key" FontSize="16" Checked="CreateVaultRecoveryChanged" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                            <ProgressRing x:Name="CreateVaultCreationProgress" Width="22" Height="22" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Creating vault" />
                            <TextBlock x:Name="CreateVaultCreationStatus" Text="" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Button Content="Back" Padding="28,9" Click="ReturnToCreateVaultReview" AutomationProperties.Name="Back to vault review" />
                        <Button x:Name="CreateVaultFinalButton" Content="Create Vault" Padding="26,9" HorizontalAlignment="Right" IsEnabled="False" Background="#2B83E7" Foreground="White" Click="SubmitCreateVault" AutomationProperties.Name="Create Vault" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="CreateVaultSuccessView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="900" Margin="42,36,42,42" HorizontalAlignment="Center" Spacing="16">
                    <Grid Width="250" Height="118" HorizontalAlignment="Center">
                        <Image Source="Assets/vaultkind_full_lockup.png" Stretch="Uniform" />
                        <Border Width="44" Height="44" CornerRadius="22" Background="#2B83E7" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="#252A2E" BorderThickness="4">
                            <FontIcon Glyph="&#xE73E;" Foreground="White" FontSize="20" />
                        </Border>
                    </Grid>
                    <TextBlock Text="Your vault is ready." FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Center" FontSize="17">
                        <Run x:Name="CreatedVaultNameText" Text="Your vault" FontWeight="SemiBold" />
                        <Run Text=" has been added successfully." />
                    </TextBlock>
                    <TextBlock Text="Unlock it now to start adding files, or choose Done and come back whenever you're ready." Foreground="{StaticResource MutedTextBrush}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />

                    <Border x:Name="CreatedRecoveryKeyPanel" Background="{StaticResource CardBrush}" BorderBrush="#2B83E7" BorderThickness="1" CornerRadius="12" Padding="20,16" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource IconSurfaceBrush}"><FontIcon Glyph="&#xE192;" Foreground="{StaticResource BrandBlueBrush}" FontSize="22" /></Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Save your recovery key" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="It can restore access if you forget your password. Keep it somewhere secure and separate from the vault." Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <TextBox x:Name="CreatedRecoveryKeyText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" FontFamily="Consolas" AutomationProperties.Name="Recovery key" />
                            <Button Content="Copy Recovery Key" HorizontalAlignment="Right" Padding="18,8" Click="CopyCreatedRecoveryKey" AutomationProperties.Name="Copy recovery key" />
                            <TextBlock x:Name="CreatedRecoveryKeyCopyStatus"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Right"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                            <CheckBox x:Name="CreatedRecoveryKeySaved" Content="I have saved this recovery key somewhere secure" Checked="CreatedRecoveryKeySavedChanged" Unchecked="CreatedRecoveryKeySavedChanged" />
                        </StackPanel>
                    </Border>

                    <Border Background="#3B341D" BorderBrush="#D6A900" BorderThickness="1" CornerRadius="10" Padding="16,12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE7BA;" Foreground="#FFC107" VerticalAlignment="Top" Margin="0,3,0,0" />
                            <TextBlock Grid.Column="1" Text="VaultKind cannot recover your password. Anyone with the recovery key can restore access, so treat it like a master key." TextWrapping="Wrap" FontSize="13" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button x:Name="CreatedVaultDoneButton" Content="Done" Padding="28,9" Click="FinishCreateVault" AutomationProperties.Name="Done" />
                        <Button x:Name="CreatedVaultUnlockButton" Content="Unlock Now" Padding="24,9" Background="#2B83E7" Foreground="White" Click="UnlockCreatedVault" AutomationProperties.Name="Unlock newly created vault" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="VaultView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="VaultContent" MaxWidth="1120" Margin="36,34,36,50" HorizontalAlignment="Center" Spacing="20">
                    <Grid ColumnSpacing="18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource IconSurfaceBrush}">
                            <FontIcon x:Name="SelectedVaultIcon" Glyph="&#xE72E;" FontSize="27" Foreground="{StaticResource BrandBlueBrush}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="SelectedVaultName" Text="Vault" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock x:Name="SelectedVaultPath" Text="Vault location" FontSize="14" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border x:Name="SelectedVaultStatusBorder" Grid.Column="2" BorderBrush="{StaticResource BrandBlueBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                            <TextBlock x:Name="SelectedVaultStatus" Text="LOCKED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandBlueBrush}" />
                        </Border>
                    </Grid>

                    <Border Height="1" Background="{StaticResource DividerBrush}" />

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28">
                        <Grid ColumnSpacing="20">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="64" Height="64" CornerRadius="32" Background="#314239" VerticalAlignment="Center">
                                <FontIcon x:Name="SelectedVaultStateIcon" Glyph="&#xE72E;" FontSize="30" Foreground="{StaticResource BrandBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                                <TextBlock x:Name="SelectedVaultStateTitle" Text="Your vault is protected" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="SelectedVaultStateDescription" Text="Its readable view is closed. The encrypted files remain safely stored." TextWrapping="Wrap" FontSize="16" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                            <Button x:Name="UnlockVaultButton" Grid.Column="2" Content="Unlock Vault" Padding="22,10" VerticalAlignment="Center" Click="ShowUnlock" AutomationProperties.Name="Unlock Vault" />
                            <StackPanel x:Name="UnlockedVaultActions" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center" Spacing="10">
                                <Button x:Name="OpenDriveButton" Content="Open Drive" Padding="22,10" HorizontalAlignment="Stretch" Click="OpenDrive" AutomationProperties.Name="Open readable drive" />
                                <Button x:Name="LockVaultButton" Content="Lock Vault" Padding="22,10" HorizontalAlignment="Stretch" Click="LockVault" AutomationProperties.Name="Lock vault" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE946;" Foreground="{StaticResource BrandBlueBrush}" FontSize="20" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="Connected to the VaultKind engine" FontSize="17" />
                                <TextBlock Text="This state and location come directly from the local vault engine. No network service is involved." TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="UnlockedVaultTools" Visibility="Collapsed" Spacing="10">
                        <TextBlock Text="Vault tools" FontSize="18" FontWeight="SemiBold" />
                        <Grid x:Name="VaultToolsGrid" ColumnSpacing="14" RowSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="VaultToolsColumn1" Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource IconSurfaceBrush}" VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="{StaticResource BrandBlueBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Locate Encrypted File" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Find the encrypted storage entry behind a readable file." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                        <Button x:Name="VaultLocateEncryptedFileButton" Content="Choose Readable File" HorizontalAlignment="Left" Padding="16,8" Click="ShowLocateEncryptedFile" AutomationProperties.Name="Locate the encrypted entry for a readable file" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="DecryptFileToolCard" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource IconSurfaceBrush}" VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="22" Foreground="{StaticResource BrandBlueBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Decrypt File Name" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Identify the readable name behind an encrypted .c9r file." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                        <Button x:Name="VaultDecryptFileNameButton" Content="Choose Encrypted File" HorizontalAlignment="Left" Padding="16,8" Click="ShowDecryptFileName" AutomationProperties.Name="Decrypt an encrypted file name" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="VaultStatisticsToolCard" Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource IconSurfaceBrush}" VerticalAlignment="Top">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{StaticResource BrandBlueBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="8">
                                        <TextBlock Text="Vault Statistics" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="Review local read, write, cache, and access counters." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                        <Button x:Name="VaultStatisticsButton" Content="View Statistics" HorizontalAlignment="Left" Padding="16,8" Click="ShowVaultStatistics" AutomationProperties.Name="View statistics for this vault" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <ProgressRing x:Name="VaultActionProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Vault action in progress" />
                        <TextBlock x:Name="VaultActionStatus" Text="" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <Border x:Name="RemoveVaultConfirmation" Visibility="Collapsed" Background="#382829" BorderBrush="#C9534B" BorderThickness="1" CornerRadius="10" Padding="18,15">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Remove this vault from VaultKind?" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="This removes the vault from the sidebar only. Its encrypted files and folder will not be deleted." TextWrapping="Wrap" Foreground="#E4B6B2" />
                            <TextBlock x:Name="RemoveVaultLocationText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="RemoveVaultPromptText" Text="Type the vault name to confirm." TextWrapping="Wrap" />
                                <TextBox x:Name="RemoveVaultNameInput" PlaceholderText="Vault name" TextChanged="RemoveVaultNameChanged" AutomationProperties.Name="Type vault name to confirm removal" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                                <Button Content="Keep Vault" Padding="18,8" Click="CancelRemoveVault" AutomationProperties.Name="Keep vault" />
                                <Button x:Name="ConfirmRemoveVaultButton" Content="Remove from VaultKind" Padding="18,8" Background="#A83E38" Foreground="White" Click="ConfirmRemoveVault" AutomationProperties.Name="Confirm remove vault from VaultKind"><Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C95149" /><SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#FF8A82" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#8C302B" /></Button.Resources></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="Back to Dashboard" HorizontalAlignment="Left" Padding="18,8" Click="ShowDashboard" AutomationProperties.Name="Back to Dashboard" />
                        <Button x:Name="ManageVaultButton" Grid.Column="1" Content="Open Vault Manager" HorizontalAlignment="Right" Padding="18,8" Background="#2B83E7" Foreground="White" Click="ShowVaultManagement" AutomationProperties.Name="Open this vault in Vault Manager" />
                        <Button x:Name="RemoveVaultButton" Grid.Column="2" Content="Remove from VaultKind" HorizontalAlignment="Right" Padding="18,8" Click="ShowRemoveVaultConfirmation" AutomationProperties.Name="Remove vault from VaultKind" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="VaultManagementView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="VaultManagementContent" MaxWidth="1120" Margin="36,30,36,50" HorizontalAlignment="Center" Spacing="20">
                    <StackPanel x:Name="VaultManagementLanding" MaxWidth="1120" HorizontalAlignment="Stretch" Visibility="Collapsed" Spacing="18">
                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="20,16">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource IconSurfaceBrush}"><FontIcon Glyph="&#xE713;" FontSize="22" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock Text="Choose a vault to manage" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Nothing is selected automatically. Choose the vault whose settings, recovery, sharing, statistics, or removal options you want to review." TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="VaultManagementVaultList" Spacing="12" />
                    </StackPanel>
                    <Grid x:Name="VaultManagementHome" MaxWidth="1120" HorizontalAlignment="Stretch" RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="7">
                            <TextBlock Text="Vault to manage" FontWeight="SemiBold" />
                            <ComboBox x:Name="ManagedVaultSelector" MinWidth="260" HorizontalAlignment="Stretch" SelectionChanged="ManagedVaultSelectionChanged" AutomationProperties.Name="Choose a vault to manage" />
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnSpacing="18">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource IconSurfaceBrush}">
                                <FontIcon x:Name="ManagedVaultIcon" Glyph="&#xE72E;" FontSize="27" Foreground="{StaticResource BrandBlueBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="5">
                                <StackPanel x:Name="ManagedVaultNameDisplay" Orientation="Horizontal" Spacing="10">
                                    <TextBlock x:Name="ManagedVaultName" Text="Manage Vault" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    <Button x:Name="ManagedVaultRenameButton" Content="Rename" Padding="12,6" VerticalAlignment="Center" Click="BeginManagedVaultRename" AutomationProperties.Name="Rename this vault" />
                                </StackPanel>
                                <StackPanel x:Name="ManagedVaultRenameEditor" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                                    <TextBox x:Name="ManagedVaultRenameInput" Width="280" MaxLength="50" PlaceholderText="Vault name" KeyDown="ManagedVaultRenameKeyDown" AutomationProperties.Name="New vault name" />
                                    <Button x:Name="ManagedVaultRenameSave" Content="Save" Padding="14,7" Click="SaveManagedVaultRename" />
                                    <Button Content="Cancel" Padding="14,7" Click="CancelManagedVaultRename" />
                                </StackPanel>
                                <TextBlock x:Name="ManagedVaultPath" Text="Vault location" FontSize="14" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                <TextBlock x:Name="ManagedVaultRenameStatus" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                            <Border x:Name="ManagedVaultStatusBorder" Grid.Column="2" BorderBrush="{StaticResource BrandBlueBrush}" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                                <TextBlock x:Name="ManagedVaultStatus" Text="LOCKED" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrandBlueBrush}" />
                            </Border>
                        </Grid>

                        <Grid x:Name="ManagementPrimaryCards" Grid.Row="2" ColumnSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ManagementPrimaryColumn1" Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="12">
                                    <FontIcon Glyph="&#xE72D;" Foreground="{StaticResource BrandBlueBrush}" FontSize="27" HorizontalAlignment="Left" />
                                    <TextBlock Text="Share this vault safely" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Learn how to share the encrypted storage folder without exposing readable files or sending anything through VaultKind." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                    <Button x:Name="ManagedShareGuideButton" Content="View Sharing Guide" HorizontalAlignment="Left" Padding="18,8" Click="ShowVaultShareGuide" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ManagementPasswordCard" Grid.Column="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="12">
                                    <FontIcon Glyph="&#xE8D7;" Foreground="{StaticResource BrandBlueBrush}" FontSize="27" HorizontalAlignment="Left" />
                                    <TextBlock Text="Password &amp; recovery" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Change a known password, or restore access with a recovery key. Everything remains on this computer." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                    <Grid ColumnSpacing="10" RowSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Button x:Name="ManagedChangePasswordButton" Content="Change Password" HorizontalAlignment="Stretch" Padding="14,8" Click="ShowManagedChangePassword" />
                                        <Button x:Name="ManagedShowRecoveryKeyButton" Grid.Column="1" Content="Show Recovery Key" HorizontalAlignment="Stretch" Padding="14,8" Click="ShowManagedRecoveryKey" />
                                        <Button x:Name="ManagedRecoveryButton" Grid.Row="1" Grid.ColumnSpan="2" Content="Use Recovery Key" HorizontalAlignment="Stretch" Padding="14,8" Click="ShowManagedRecovery" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="ManagementSecondaryCards" Grid.Row="3" ColumnSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="ManagementSecondaryColumn1" Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="10">
                                    <FontIcon Glyph="&#xE95E;" Foreground="{StaticResource BrandBlueBrush}" FontSize="26" HorizontalAlignment="Left" />
                                    <TextBlock Text="Vault Doctor" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Run automatic, read-only checks across VaultKind, Windows, storage, and your configured vaults." TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}" />
                                    <Button Content="Open Vault Doctor" HorizontalAlignment="Left" Padding="18,8" Click="ShowManagedDoctor" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ManagementRemovalCard" Grid.Column="1" Background="#382829" BorderBrush="#8F4A45" BorderThickness="1" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="10">
                                    <FontIcon Glyph="&#xE74D;" Foreground="#E57870" FontSize="26" HorizontalAlignment="Left" />
                                    <TextBlock Text="Remove from VaultKind" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="Remove this vault from the sidebar without deleting its encrypted files or storage folder." TextWrapping="Wrap" Foreground="#E4B6B2" />
                                    <Button x:Name="ManagedRemoveButton" Content="Review Removal" HorizontalAlignment="Left" Padding="18,8" Click="ShowManagedRemoval" />
                                    <TextBlock x:Name="ManagedRemoveHint" Text="Lock this vault before removing it from VaultKind." TextWrapping="Wrap" Foreground="#E4B6B2" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                            <Button Content="Back to All Vaults" Padding="18,8" Click="ShowVaultManagerFromSidebar" AutomationProperties.Name="Return to the Vault Manager vault list" />
                            <Button Content="Back to Vault" Padding="18,8" Click="ReturnToManagedVault" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="VaultShareGuide" MaxWidth="1120" HorizontalAlignment="Stretch" Visibility="Collapsed" Spacing="18">
                        <Button Content="‹ Back to Vault Management" HorizontalAlignment="Left" Padding="18,8" Click="HideVaultShareGuide" />
                        <StackPanel Spacing="5">
                            <TextBlock Text="Share this vault safely" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock Text="VaultKind never sends your vault or password anywhere. Sharing is a deliberate two-part process that you control." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                                <StackPanel Spacing="10">
                                    <FontIcon Glyph="&#xE8B7;" Foreground="{StaticResource BrandBlueBrush}" FontSize="28" HorizontalAlignment="Left" />
                                    <TextBlock Text="1. Share the encrypted storage folder" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Use your cloud provider, network drive, external drive, or another trusted transfer method. The folder contents remain encrypted." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
