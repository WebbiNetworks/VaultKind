                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DecryptResultColumn1" Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="5">
                                    <TextBlock Text="Encrypted file name" Foreground="{StaticResource InfoTextBrush}" />
                                    <TextBlock x:Name="EncryptedFileNameText" Text="example.c9r" FontSize="18" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="DecryptReadableResult" Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Readable file name" Foreground="{StaticResource InfoTextBrush}" />
                                    <TextBlock x:Name="ReadableFileNameText" Text="Example.txt" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Button Content="Copy Readable Name" HorizontalAlignment="Left" Padding="16,8" Click="CopyReadableFileName" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="DecryptFileNameProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Identifying encrypted file name" />
                            <TextBlock x:Name="DecryptFileNameStatus" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>

                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE946;" Foreground="{StaticResource BrandBlueBrush}" FontSize="20" VerticalAlignment="Top" Margin="0,3,0,0" />
                                <StackPanel Grid.Column="1" Spacing="5">
                                    <TextBlock Text="Why does this exist?" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="VaultKind encrypts file names as well as file contents." TextWrapping="Wrap" Foreground="#C5D7E9" />
                                    <TextBlock Text="This tool helps identify encrypted file names when working with backups, cloud storage, or troubleshooting." TextWrapping="Wrap" Foreground="#C5D7E9" />
                                    <TextBlock Text="The encrypted file is never modified." TextWrapping="Wrap" Foreground="#C5D7E9" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#1E3829" BorderBrush="#268B45" BorderThickness="1" CornerRadius="10" Padding="16,12">
                            <TextBlock Text="The selected path and readable name remain on this computer. VaultKind does not upload the file or result." TextWrapping="Wrap" Foreground="#B9EAC7" />
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="UnlockView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="760" Margin="42,38,42,50" HorizontalAlignment="Center" Spacing="20">
                    <Border Background="{StaticResource DeepSurfaceBrush}" BorderBrush="{StaticResource StrongDividerBrush}" BorderThickness="1" CornerRadius="12" Padding="30">
                        <StackPanel Spacing="22">
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource IconSurfaceBrush}">
                                    <FontIcon Glyph="&#xE72E;" FontSize="27" Foreground="{StaticResource BrandBlueBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                    <TextBlock x:Name="UnlockVaultName" Text="Vault" FontSize="25" FontWeight="SemiBold" />
                                    <TextBlock x:Name="UnlockVaultPath" Text="Vault location" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="8">
                                <TextBlock Text="Vault password" FontSize="15" />
                                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><PasswordBox x:Name="UnlockPassword" PlaceholderText="Enter your password" PasswordRevealMode="Hidden" FontSize="17" Padding="12,9" KeyDown="UnlockPasswordKeyDown" AutomationProperties.Name="Vault password" /><Button Grid.Column="1" Width="46" Tag="UnlockPassword" Click="TogglePasswordVisibility" AutomationProperties.Name="Show vault password"><FontIcon Glyph="&#xE890;" /></Button></Grid>
                                <TextBlock Text="Your password is sent only to the local VaultKind engine on this computer." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                            </StackPanel>

							<Grid RowSpacing="12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
								<Grid ColumnSpacing="9" VerticalAlignment="Center">
									<Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
									<ProgressRing x:Name="UnlockProgress" Width="20" Height="20" IsActive="False" AutomationProperties.Name="Opening vault" />
									<TextBlock x:Name="UnlockStatus" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
								</Grid>
                                <StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                                    <Button Content="Cancel" Padding="20,9" Click="CancelUnlock" />
                                    <Button x:Name="UnlockSubmitButton" Content="Unlock" Padding="24,9" Background="#287FE5" Click="SubmitUnlock" AutomationProperties.Name="Unlock vault" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
