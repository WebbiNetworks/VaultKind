                                    <Button x:Name="ChooseEncryptedFileButton" Content="Choose Specific File..." Padding="18,8" HorizontalAlignment="Stretch" Click="ChooseEncryptedFileForDecryption" AutomationProperties.Name="Choose a specific encrypted file to identify" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="DecryptFileNameResult" Visibility="Collapsed" Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
