                                <TextBlock Text="Automatic, private checks across VaultKind, Windows, and your vaults." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border x:Name="DoctorPrivacyBadge" Grid.Column="2" Background="#263F31" BorderBrush="#3F965B" BorderThickness="1" CornerRadius="14" Padding="12,5" VerticalAlignment="Center">
                                <TextBlock Text="LOCAL &amp; PRIVATE" FontSize="11" FontWeight="SemiBold" Foreground="#51D478" />
                            </Border>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="5" Margin="20,8">
                        <ProgressRing x:Name="DoctorProgressRing" Width="30" Height="30" HorizontalAlignment="Center" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Vault Doctor is running" />
                        <TextBlock x:Name="DoctorSummary" Text="Vault Doctor is ready to run local checks." TextWrapping="Wrap" FontSize="20" TextAlignment="Center" />
                        <TextBlock x:Name="DoctorScope" Text="All configured vaults" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" />
                    </StackPanel>

                    <Border x:Name="DoctorCompletionCard" Visibility="Collapsed" Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="2" CornerRadius="11" Padding="18,15">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource IconSurfaceBrush}">
                                <FontIcon x:Name="DoctorCompletionIcon" Glyph="&#xE73E;" FontSize="23" Foreground="#49CD70" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock x:Name="DoctorCompletionTitle" Text="Check complete" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DoctorCompletionDescription" Text="Read-only checks completed locally. No vault data was changed." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid x:Name="DoctorMetrics" ColumnSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DoctorMetricColumn1" Width="*" /><ColumnDefinition x:Name="DoctorMetricColumn2" Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}" BorderBrush="#3F965B"><StackPanel HorizontalAlignment="Center" Spacing="5"><TextBlock x:Name="DoctorHealthyCount" Text="0" FontSize="28" /><TextBlock Text="Healthy" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border>
                        <Border x:Name="DoctorAttentionMetric" Grid.Column="1" Style="{StaticResource MetricCardStyle}" BorderBrush="#B18B20"><StackPanel HorizontalAlignment="Center" Spacing="5"><TextBlock x:Name="DoctorAttentionCount" Text="0" FontSize="28" /><TextBlock Text="Needs attention" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border>
                        <Border x:Name="DoctorInformationMetric" Grid.Column="2" Style="{StaticResource MetricCardStyle}" BorderBrush="{StaticResource InfoBorderBrush}"><StackPanel HorizontalAlignment="Center" Spacing="5"><TextBlock x:Name="DoctorInformationCount" Text="0" FontSize="28" /><TextBlock Text="Information" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border>
                    </Grid>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="22">
                        <StackPanel Spacing="12">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="DoctorChecksTitle" Text="Automatic checks" FontSize="18" /><Button x:Name="DoctorRunAgainButton" Grid.Column="1" Content="Run Doctor Again" Click="RunDoctorPreview" Padding="16,7" /></Grid>
                            <StackPanel x:Name="DoctorChecksPanel" Spacing="10" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Content="Back to Dashboard" HorizontalAlignment="Left" Padding="18,8" Click="ShowDashboard" AutomationProperties.Name="Back to Dashboard" />
                        <StackPanel x:Name="DoctorFooterActions" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="DoctorSaveReportStatus" VerticalAlignment="Center" Foreground="#51D478" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                            <Button x:Name="DoctorSaveReportButton" Content="Save Report…" Padding="18,8" Click="SaveDoctorReport" IsEnabled="False" AutomationProperties.Name="Save this Vault Doctor report locally" />
                            <Button x:Name="DoctorAssistantButton" Content="Open Assistant" Padding="18,8" Click="OpenDoctorAssistant" AutomationProperties.Name="Open this result in VaultKind Assistant" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ActivityView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ActivityContent" MaxWidth="1120" Margin="42,34,42,50" HorizontalAlignment="Center" Spacing="18">
                    <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="20,16">
                        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource IconSurfaceBrush}"><FontIcon Glyph="&#xE7ED;" FontSize="22" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="Private local history" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="VaultKind keeps this activity on your computer between app sessions. File names, file contents, passwords, and recovery keys are never included." TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}" FontSize="12" /></StackPanel>
                        </Grid>
                    </Border>
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="Activity history" FontSize="22" FontWeight="SemiBold" /><Button x:Name="ClearActivityButton" Grid.Column="1" Content="Clear Activity" HorizontalAlignment="Right" Padding="16,7" Click="ShowClearActivityConfirmation" AutomationProperties.Name="Review clearing stored activity" /></Grid>
                    <Border x:Name="ActivityClearConfirmation" Visibility="Collapsed" Background="#412B2C" BorderBrush="#C65A5A" BorderThickness="1" CornerRadius="11" Padding="20,16">
                        <Grid ColumnSpacing="16">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE74D;" Foreground="#FF7770" FontSize="23" VerticalAlignment="Center" />
                            <StackPanel x:Name="ActivityClearDescription" Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="Clear local activity history?" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="This removes VaultKind's local activity record only. Your vaults, encrypted files, passwords, and recovery keys are not changed." TextWrapping="Wrap" Foreground="#E7B9B6" />
                            </StackPanel>
                            <Button x:Name="ActivityClearCancelButton" Grid.Column="2" Content="Keep History" Padding="18,8" Click="HideClearActivityConfirmation" />
                            <Button x:Name="ActivityClearConfirmButton" Grid.Column="3" Content="Clear History" Padding="18,8" Background="#9B3F3F" Foreground="White" Click="ClearActivity" AutomationProperties.Name="Permanently clear local activity history" />
                        </Grid>
                    </Border>
                    <TextBox x:Name="ActivitySearchInput" PlaceholderText="Search activity by action, vault, or detail" TextChanged="SearchActivityHistory" AutomationProperties.Name="Search activity history" />
                    <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16,12">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="All recorded activity" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="ActivityFilterSummary" Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource InfoTextBrush}" FontWeight="SemiBold" /></Grid>
                    </Border>
                    <Border x:Name="ActivityEmptyState" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="30" MinHeight="200">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="9"><FontIcon Glyph="&#xE7ED;" FontSize="30" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="ActivityEmptyTitle" Text="No vault activity yet" FontSize="19" HorizontalAlignment="Center" /><TextBlock x:Name="ActivityEmptyDescription" Text="Unlocking, locking, creating, connecting, removing, and recovering vaults will appear here." MaxWidth="520" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
                    </Border>
                    <StackPanel x:Name="ActivityEventsPanel" Spacing="10" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SettingsContent" MaxWidth="1120" Margin="42,34,42,50" HorizontalAlignment="Center" Spacing="18">
                    <StackPanel Spacing="5"><TextBlock Text="VaultKind preferences" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="Clear Windows-focused defaults, with privacy and accessibility built in." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>

                    <Grid x:Name="SettingsTabs" ColumnSpacing="8">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SettingsTabColumn5" Width="0" /></Grid.ColumnDefinitions>
                        <Button x:Name="SettingsGeneralButton" Tag="general" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10" Click="SelectSettingsSection" KeyDown="SettingsSectionKeyDown" AutomationProperties.Name="General preferences"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE713;" FontSize="15" /><TextBlock x:Name="SettingsGeneralText" Text="General" /></StackPanel></Button>
                        <Button x:Name="SettingsAppearanceButton" Grid.Column="1" Tag="appearance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10" Click="SelectSettingsSection" KeyDown="SettingsSectionKeyDown" AutomationProperties.Name="Appearance preferences"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE706;" FontSize="15" /><TextBlock x:Name="SettingsAppearanceText" Text="Appearance" /></StackPanel></Button>
                        <Button x:Name="SettingsVirtualDriveButton" Grid.Column="2" Tag="virtual-drive" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10" Click="SelectSettingsSection" KeyDown="SettingsSectionKeyDown" AutomationProperties.Name="Virtual Drive preferences"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xEDA2;" FontSize="15" /><TextBlock x:Name="SettingsVirtualDriveText" Text="Virtual Drive" /></StackPanel></Button>
                        <Button x:Name="SettingsPrivacyButton" Grid.Column="3" Tag="privacy" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10" Click="SelectSettingsSection" KeyDown="SettingsSectionKeyDown" AutomationProperties.Name="Privacy preferences"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE72E;" FontSize="15" /><TextBlock x:Name="SettingsPrivacyText" Text="Privacy" /></StackPanel></Button>
                        <Button x:Name="SettingsAboutButton" Grid.Column="4" Tag="about" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12,10" Click="SelectSettingsSection" KeyDown="SettingsSectionKeyDown" AutomationProperties.Name="About VaultKind"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE946;" FontSize="15" /><TextBlock x:Name="SettingsAboutText" Text="About" /></StackPanel></Button>
                    </Grid>

                    <Border x:Name="SettingsAppearancePanel" Style="{StaticResource MetricCardStyle}" Padding="22" Visibility="Collapsed">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="3"><TextBlock Text="Appearance" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Choose the appearance that is most comfortable for you." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource InfoSurfaceBrush}"><FontIcon Glyph="&#xE706;" FontSize="21" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock x:Name="AppearanceModeName" Text="Dark — Low Glare" FontSize="17" /><TextBlock x:Name="AppearanceModeDescription" Text="Charcoal surfaces, restrained contrast, and VaultKind blue accents." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center"><TextBlock Text="Light" VerticalAlignment="Center" /><ToggleSwitch x:Name="DarkAppearanceToggle" IsOn="True" OnContent="" OffContent="" Toggled="AppearanceModeChanged" AutomationProperties.Name="Use dark appearance" /><TextBlock Text="Dark" VerticalAlignment="Center" /></StackPanel>
                            </Grid>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource InfoSurfaceBrush}"><FontIcon Glyph="&#xE8D2;" FontSize="21" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="Larger text" FontSize="17" /><TextBlock Text="Increases text throughout VaultKind while preserving the familiar layout." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                                <ToggleSwitch x:Name="LargerTextToggle" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="LargerTextChanged" VerticalAlignment="Center" AutomationProperties.Name="Use larger text throughout VaultKind" />
                            </Grid>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource InfoSurfaceBrush}"><FontIcon Glyph="&#xE767;" FontSize="21" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="Signature sounds" FontSize="17" /><TextBlock Text="Brief local sounds for opening, locking, and moments that need your attention." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                                <ToggleSwitch x:Name="SignatureSoundsToggle" Grid.Column="2" IsOn="True" OnContent="On" OffContent="Off" Toggled="SignatureSoundsChanged" VerticalAlignment="Center" AutomationProperties.Name="Use VaultKind signature sounds" />
                            </Grid>
                            <Border Background="{StaticResource DeepSurfaceBrush}" CornerRadius="9" Padding="16,13">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3"><TextBlock Text="Preview the three sounds" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="Short, calm, and designed to stay out of the way." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="Vault Open" Tag="open" Click="PreviewSignatureSound" AutomationProperties.Name="Preview Vault Open sound" />
                                        <Button Content="Vault Locked" Tag="locked" Click="PreviewSignatureSound" AutomationProperties.Name="Preview Vault Locked sound" />
                                        <Button Content="Warning" Tag="warning" Click="PreviewSignatureSound" AutomationProperties.Name="Preview Warning sound" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource DeepSurfaceBrush}" CornerRadius="8" Padding="15,11"><TextBlock Text="Light and Dark are included for everyone. VaultKind never requires a paid theme unlock." Foreground="{StaticResource InfoTextBrush}" TextWrapping="Wrap" FontSize="12" /></Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsGeneralPanel" Style="{StaticResource MetricCardStyle}" Padding="22">
                        <StackPanel Spacing="17">
                            <StackPanel Spacing="3"><TextBlock Text="Windows behavior" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Choose how VaultKind behaves while keeping secure shutdown protection in place." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE768;" Foreground="{StaticResource BrandBlueBrush}" FontSize="20" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Launch VaultKind when Windows starts" FontSize="16" /><TextBlock Text="Registers this desktop app for your Windows account. Vaults remain locked until you choose to unlock them." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel><ToggleSwitch x:Name="LaunchWithWindowsToggle" Grid.Column="2" OnContent="On" OffContent="Off" Toggled="LaunchWithWindowsChanged" VerticalAlignment="Center" AutomationProperties.Name="Launch VaultKind when Windows starts" /></Grid>
                            <TextBlock x:Name="LaunchWithWindowsStatus" Visibility="Collapsed" Foreground="#FF5C57" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" />
                            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7F4;" Foreground="{StaticResource BrandBlueBrush}" FontSize="20" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Remember window placement" FontSize="16" /><TextBlock Text="Restores the previous size, position, monitor, and maximized state when possible." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel><ToggleSwitch x:Name="RememberWindowPlacementToggle" Grid.Column="2" IsOn="True" OnContent="On" OffContent="Off" Toggled="RememberWindowPlacementChanged" VerticalAlignment="Center" AutomationProperties.Name="Remember window placement" /></Grid>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" />
                            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE72E;" Foreground="{StaticResource BrandBlueBrush}" FontSize="20" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Protect vaults when VaultKind closes" FontSize="16" /><TextBlock Text="The local engine locks every open vault before it shuts down, preventing stale readable drives." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="2" Text="Always on" Foreground="#49CD70" VerticalAlignment="Center" FontWeight="SemiBold" /></Grid>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" />
                            <Grid ColumnSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE9D9;" Foreground="{StaticResource BrandBlueBrush}" FontSize="20" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Diagnostics" FontSize="16" /><TextBlock Text="Open the VaultKind diagnostics folder." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel><Button x:Name="DiagnosticsFolderButton" Grid.Column="2" Content="Open Log Folder" Click="OpenDiagnosticsFolder" VerticalAlignment="Center" AutomationProperties.Name="Open VaultKind diagnostics folder" /></Grid>
                            <TextBlock x:Name="DiagnosticsFolderStatus" Visibility="Collapsed" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsVirtualDrivePanel" Style="{StaticResource MetricCardStyle}" Padding="22" Visibility="Collapsed">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="3"><TextBlock Text="Virtual Drive" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Choose which installed Windows drive provider VaultKind should use when opening vaults." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            <Border Background="{StaticResource DeepSurfaceBrush}" CornerRadius="9" Padding="17,14">
                                <Grid ColumnSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource InfoSurfaceBrush}"><FontIcon Glyph="&#xEDA2;" FontSize="21" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="Default drive provider" FontSize="16" /><ComboBox x:Name="MountServiceSelector" MinWidth="340" HorizontalAlignment="Left" DisplayMemberPath="Name" SelectionChanged="MountServiceSelectionChanged" AutomationProperties.Name="Default virtual drive provider" /></StackPanel>
                                    <Button x:Name="RefreshProvidersButton" Grid.Column="2" Content="Refresh Providers" Click="RefreshMountServices" VerticalAlignment="Bottom" AutomationProperties.Name="Refresh installed virtual drive providers" />
                                </Grid>
                            </Border>
                            <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="17,14">
                                <StackPanel Spacing="8"><TextBlock Text="Supported by this provider" FontSize="16" FontWeight="SemiBold" /><TextBlock x:Name="MountServiceCapabilities" Text="Select Virtual Drive to load the providers installed on this computer." Foreground="{StaticResource InfoTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <TextBlock x:Name="MountServiceStatus" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <Border Background="#393A22" BorderBrush="#C9A900" BorderThickness="1" CornerRadius="8" Padding="15,11">
                                <Grid ColumnSpacing="11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7BA;" Foreground="#FFC400" FontSize="18" VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="What this changes" Foreground="#FFE28A" FontWeight="SemiBold" />
                                        <TextBlock Text="The provider creates the readable Windows drive you use while a vault is unlocked. It does not change the encrypted vault format or move any files." Foreground="#FFE28A" TextWrapping="Wrap" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="This default applies the next time a vault is unlocked. Vaults that are already open are not interrupted." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsPrivacyPanel" Style="{StaticResource MetricCardStyle}" Padding="22" Visibility="Collapsed">
                        <StackPanel Spacing="17">
                            <StackPanel Spacing="3"><TextBlock Text="Privacy" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Choose whether VaultKind keeps a private history of important vault actions on this computer." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
                            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7ED;" Foreground="{StaticResource BrandBlueBrush}" FontSize="20" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="Record local Activity history" FontSize="16" /><TextBlock Text="Stores action, time, and vault name locally. File names, contents, passwords, and recovery keys are never recorded." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel><ToggleSwitch x:Name="RecordActivityHistoryToggle" Grid.Column="2" IsOn="True" OnContent="On" OffContent="Off" Toggled="RecordActivityHistoryChanged" VerticalAlignment="Center" AutomationProperties.Name="Record local Activity history" /></Grid>
                            <Border Background="#393A22" BorderBrush="#C9A900" BorderThickness="1" CornerRadius="8" Padding="15,11">
                                <Grid ColumnSpacing="11">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7BA;" Foreground="#FFC400" FontSize="18" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="Turning this off stops new entries. Existing history remains available until you choose Clear Activity." Foreground="#FFE28A" TextWrapping="Wrap" FontSize="12" />
                                </Grid>
                            </Border>
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" />
                            <Grid ColumnSpacing="14">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE81C;" Foreground="{StaticResource BrandBlueBrush}" FontSize="20" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="Manage stored Activity" FontSize="16" />
                                    <TextBlock x:Name="PrivacyHistorySummary" Text="Review the private history currently stored on this computer." Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="ReviewActivityButton" Grid.Column="2" Content="Review Activity" Click="ShowActivity" VerticalAlignment="Center" AutomationProperties.Name="Review or clear stored Activity history" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsPrivacyPromisePanel" Visibility="Collapsed" Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="20,16">
                        <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE72E;" Foreground="{StaticResource BrandBlueBrush}" FontSize="22" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Privacy always" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Preferences, window placement, Activity, and vault commands remain on this computer. VaultKind does not require an online account or network service." Foreground="{StaticResource InfoTextBrush}" TextWrapping="Wrap" FontSize="12" /></StackPanel></Grid>
                    </Border>

                    <StackPanel x:Name="SettingsAboutPanel" Visibility="Collapsed" Spacing="18">
                        <Border Style="{StaticResource MetricCardStyle}" Padding="30,26,30,22">
                            <StackPanel Spacing="14">
                                <Image Source="Assets/vaultkind_full_lockup.png" Width="520" MaxHeight="200" HorizontalAlignment="Center" Stretch="Uniform" AutomationProperties.Name="VaultKind logo" />
                                <TextBlock Text="VaultKind Windows Desktop" FontSize="27" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Text="Desktop First • Windows Focused • Privacy Always" Foreground="{StaticResource BrandBlueBrush}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" />
                                <TextBlock Text="A private, native Windows workspace for creating, opening, and caring for encrypted vaults." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="680" HorizontalAlignment="Center" />
                            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,5,0,0" />
                                <TextBlock Text="VaultKind is a GPLv3 derivative of Cryptomator. Cryptomator copyright © 2016–2026 Skymatic GmbH and contributors." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Padding="22">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="3"><TextBlock Text="This installation" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Live information reported by this copy of VaultKind and its local engine." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" /></StackPanel>
                                <Grid ColumnSpacing="20" RowSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Background="{StaticResource ListSurfaceBrush}" CornerRadius="8" Padding="15,12"><StackPanel Spacing="3"><TextBlock Text="VaultKind version" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /><TextBlock x:Name="AboutVersionText" Text="Loading..." FontSize="16" FontWeight="SemiBold" /></StackPanel></Border>
                                    <Border Grid.Column="1" Background="{StaticResource ListSurfaceBrush}" CornerRadius="8" Padding="15,12">
                                        <Grid ColumnSpacing="18">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="3">
                                                <TextBlock Text="Edition" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                                <TextBlock x:Name="AboutWindowsEditionText" Text="Loading..." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="3">
                                                <TextBlock Text="Version" Foreground="{StaticResource MutedTextBrush}" FontSize="12" />
                                                <TextBlock x:Name="AboutWindowsVersionText" Text="Loading..." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border Grid.Row="1" Background="{StaticResource ListSurfaceBrush}" CornerRadius="8" Padding="15,12"><StackPanel Spacing="3"><TextBlock Text="Local vault engine" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /><TextBlock x:Name="AboutEngineText" Text="Checking..." FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /></StackPanel></Border>
                                    <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource ListSurfaceBrush}" CornerRadius="8" Padding="15,12"><StackPanel Spacing="3"><TextBlock Text="Configured vaults" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /><TextBlock x:Name="AboutVaultCountText" Text="Checking..." FontSize="16" FontWeight="SemiBold" /></StackPanel></Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="20,16">
                            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8D7;" Foreground="{StaticResource BrandBlueBrush}" FontSize="22" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Vault compatibility comes first" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="VaultKind preserves the established vault format so encrypted storage remains portable and interoperable." Foreground="{StaticResource InfoTextBrush}" TextWrapping="Wrap" FontSize="12" /></StackPanel></Grid>
                        </Border>
                        <Border Style="{StaticResource MetricCardStyle}" Padding="22">
                            <Grid ColumnSpacing="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource IconSurfaceBrush}"><FontIcon Glyph="&#xE8F2;" FontSize="21" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="Support VaultKind" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Support options will live at vaultkind.dev. Themes, accessibility, and core privacy protections remain included for everyone." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" /></StackPanel>
                                <Button x:Name="VisitWebsiteButton" Grid.Column="2" Content="Visit vaultkind.dev" Click="OpenVaultKindWebsite" VerticalAlignment="Center" AutomationProperties.Name="Open the VaultKind website" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="AboutWebsiteStatus" Visibility="Collapsed" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="12" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="LearningView" Grid.Row="1" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Background="{StaticResource DeepSurfaceBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0" Padding="18,24">
                    <Grid>
                    <Grid x:Name="LearningNavigationPanel"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Spacing="5"><TextBlock Text="Learning Center" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Plain-language guidance for using VaultKind safely and confidently." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /></StackPanel>
                        <TextBox x:Name="LearningSearch" Grid.Row="1" Margin="0,16,0,12" PlaceholderText="Search topics" TextChanged="FilterLearningTopics" KeyDown="LearningSearchKeyDown" AutomationProperties.Name="Search Learning Center topics" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="5" Padding="0,0,4,0">
                            <Button x:Name="LearningHowButton" Tag="how" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="SelectLearningTopic"><Grid Width="220"><TextBlock Text="How VaultKind Works" /><FontIcon x:Name="LearningHowCheck" Glyph="&#xE73E;" Foreground="#49CD70" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid></Button>
                            <Button x:Name="LearningFirstButton" Tag="first" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="SelectLearningTopic"><Grid Width="220"><TextBlock Text="Your First Vault" /><FontIcon x:Name="LearningFirstCheck" Glyph="&#xE73E;" Foreground="#49CD70" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid></Button>
                            <Button x:Name="LearningRecoveryButton" Tag="recovery" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="SelectLearningTopic"><Grid Width="220"><TextBlock Text="Recovery Keys" /><FontIcon x:Name="LearningRecoveryCheck" Glyph="&#xE73E;" Foreground="#49CD70" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid></Button>
                            <Button x:Name="LearningCloudButton" Tag="cloud" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="SelectLearningTopic"><Grid Width="220"><TextBlock Text="Cloud Storage" /><FontIcon x:Name="LearningCloudCheck" Glyph="&#xE73E;" Foreground="#49CD70" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid></Button>
                            <Button x:Name="LearningDriveButton" Tag="drive" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="SelectLearningTopic"><Grid Width="220"><TextBlock Text="Virtual Drives" /><FontIcon x:Name="LearningDriveCheck" Glyph="&#xE73E;" Foreground="#49CD70" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid></Button>
                            <Button x:Name="LearningSecurityButton" Tag="security" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="SelectLearningTopic"><Grid Width="220"><TextBlock Text="Security Tips" /><FontIcon x:Name="LearningSecurityCheck" Glyph="&#xE73E;" Foreground="#49CD70" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid></Button>
                            <Button x:Name="LearningKeyboardButton" Tag="keyboard" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="SelectLearningTopic"><Grid Width="220"><TextBlock Text="Keyboard Shortcuts" /><FontIcon x:Name="LearningKeyboardCheck" Glyph="&#xE73E;" Foreground="#49CD70" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid></Button>
                            <Button x:Name="LearningFaqButton" Tag="faq" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="SelectLearningTopic"><Grid Width="220"><TextBlock Text="FAQ" /><FontIcon x:Name="LearningFaqCheck" Glyph="&#xE73E;" Foreground="#49CD70" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid></Button>
                            <TextBlock x:Name="LearningNoResults" Text="No matching topics. Try a broader search." Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="4,8" />
                        </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="3" Margin="0,10,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="12,10" Click="ShowAssistant" AutomationProperties.Name="Open VaultKind Assistant"><StackPanel Orientation="Horizontal" Spacing="9"><FontIcon Glyph="&#xE946;" Foreground="{StaticResource BrandBlueBrush}" /><TextBlock Text="VaultKind Assistant" FontWeight="SemiBold" /></StackPanel></Button>
                        <StackPanel Grid.Row="4" Spacing="8">
                            <TextBlock Text="YOUR PROGRESS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" />
                            <ProgressBar x:Name="LearningProgressBar" Minimum="0" Maximum="8" Value="0" Height="8" Foreground="{StaticResource BrandBlueBrush}" AutomationProperties.Name="Learning Center progress, 0 of 8 topics viewed" />
                            <TextBlock x:Name="LearningProgressText" Text="0 of 8 topics viewed" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                            <Button Content="Reset viewed topics" HorizontalAlignment="Stretch" Click="ResetLearningProgress" AutomationProperties.Name="Reset viewed Learning Center topics" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="AssistantNavigationPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Button Content="‹  Back to Learning Center" HorizontalAlignment="Stretch" Padding="12,9" Click="ReturnToLearningCenter" />
                        <StackPanel Grid.Row="1" Margin="0,18,0,14" Spacing="5"><TextBlock Text="VaultKind Assistant" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Local troubleshooting guidance organized by diagnostic case." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /></StackPanel>
                        <StackPanel Grid.Row="2" Spacing="6">
                            <TextBlock Text="BROWSE CASES" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                            <Button Tag="all" Content="All Cases (13)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Click="BrowseAssistantCases" />
                            <Button Tag="startup" Content="Startup (2)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Click="BrowseAssistantCases" />
                            <Button Tag="vault" Content="Vault (4)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Click="BrowseAssistantCases" />
                            <Button Tag="filesystem" Content="Filesystem (5)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Click="BrowseAssistantCases" />
                            <Button Tag="recovery" Content="Recovery (2)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="14,10" Click="BrowseAssistantCases" />
                        </StackPanel>
                        <Border Grid.Row="3" Background="{StaticResource DeepSurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="13,11"><StackPanel Spacing="4"><TextBlock Text="LOCAL &amp; PRIVATE" FontSize="12" /><TextBlock Text="Searches and guidance remain on this computer." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /></StackPanel></Border>
                    </Grid>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="LearningContentScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LearningContentPanel" MaxWidth="860" Margin="42,30,42,50" HorizontalAlignment="Center" Spacing="18">
                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="20,17">
                            <Grid ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon x:Name="LearningTopicIcon" Glyph="&#xE72E;" FontSize="24" Foreground="{StaticResource BrandBlueBrush}" /><StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Name="LearningTopicTitle" Text="How VaultKind Works" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="LearningTopicSummary" Text="Understand what is encrypted, where it is stored, and how you safely access it." TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}" /></StackPanel></Grid>
                        </Border>

                        <StackPanel x:Name="LearningHowContent" Spacing="18">
                            <TextBlock Text="The everyday workflow" FontSize="21" FontWeight="SemiBold" />
                            <Grid x:Name="LearningWorkflowGrid" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LearningWorkflowColumn1" Width="*" /><ColumnDefinition x:Name="LearningWorkflowColumn2" Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="9"><TextBlock Text="1  Choose encrypted storage" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Pick a local folder or one synchronized by your cloud provider." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border>
                                <Border x:Name="LearningWorkflowStep2" Grid.Column="1" Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="9"><TextBlock Text="2  Unlock with VaultKind" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Your password unlocks the vault on this device. It is never sent to your cloud provider." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border>
                                <Border x:Name="LearningWorkflowStep3" Grid.Column="2" Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="9"><TextBlock Text="3  Work in the virtual drive" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Open, edit, and save files normally. Lock the vault when you are finished." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border>
                            </Grid>
                            <TextBlock Text="One vault, two different views" FontSize="21" FontWeight="SemiBold" />
                            <TextBlock Text="Add and open files through the unlocked virtual drive—not inside the encrypted storage folder." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            <Grid x:Name="LearningViewsGrid" ColumnSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="LearningViewsColumn1" Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="5"><TextBlock Text="Encrypted storage folder" FontSize="16" /><TextBlock Text="Contains scrambled file names and encrypted data suitable for local or cloud storage." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border><Border x:Name="LearningUnlockedViewCard" Grid.Column="1" Style="{StaticResource MetricCardStyle}"><StackPanel Spacing="5"><TextBlock Text="Unlocked virtual drive" FontSize="16" /><TextBlock Text="Shows the familiar files and folders that only you can read and work with." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" /></StackPanel></Border></Grid>
                        </StackPanel>

                        <StackPanel x:Name="LearningSimpleContent" Visibility="Collapsed" Spacing="16">
                            <TextBlock x:Name="LearningBodyText" TextWrapping="Wrap" FontSize="17" LineHeight="27" />
                            <StackPanel x:Name="LearningArticleSectionsPanel" Spacing="12" />
                            <Border Background="#393A22" BorderBrush="#C9A900" BorderThickness="1" CornerRadius="10" Padding="18,15"><Grid ColumnSpacing="13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE7BA;" Foreground="#FFC400" FontSize="20" /><TextBlock x:Name="LearningTipText" Grid.Column="1" TextWrapping="Wrap" /></Grid></Border>
                        </StackPanel>
                        <Grid><Button Content="Back to Dashboard" Padding="18,8" Click="ShowDashboard" /><Button Content="Add a Vault" Padding="20,8" HorizontalAlignment="Right" Background="#287FE5" Click="ShowAddVault" /></Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AssistantContentScroll" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="AssistantContentPanel" MaxWidth="1120" Margin="42,30,42,50" HorizontalAlignment="Center" Spacing="18">
                        <Grid ColumnSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Width="48" Height="48" CornerRadius="24" Background="{StaticResource IconSurfaceBrush}"><FontIcon Glyph="&#xE946;" FontSize="24" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock Text="VaultKind Assistant" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Searchable, plain-language help for common vault problems." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" /></StackPanel>
                            <Border x:Name="AssistantPrivacyBadge" Grid.Column="2" Padding="11,5" CornerRadius="13" BorderBrush="#49CD70" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="OFFLINE &amp; PRIVATE" Foreground="#49CD70" FontSize="11" FontWeight="SemiBold" /></Border>
                        </Grid>

                        <StackPanel Spacing="8"><TextBlock Text="Search known issues" FontSize="18" /><Grid ColumnSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="AssistantSearch" PlaceholderText="Paste an error code or describe what happened" TextChanged="FilterAssistantCases" KeyDown="AssistantSearchKeyDown" AutomationProperties.Name="Search known VaultKind issues" /><Button x:Name="AssistantFindFixButton" Grid.Column="1" Content="Find a Fix" Padding="18,8" Click="FindAssistantFix" AutomationProperties.Name="Open the closest diagnostic match" /></Grid></StackPanel>

                        <StackPanel Spacing="9"><TextBlock Text="What do you need help with?" FontSize="18" /><Grid x:Name="AssistantQuickCases" ColumnSpacing="10" RowSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="AssistantQuickCasesColumn1" Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Button Tag="VK-1001" Content="I cannot unlock a vault" HorizontalAlignment="Stretch" Click="OpenAssistantQuickCase" />
                            <Button x:Name="AssistantQuickCase2" Grid.Column="1" Tag="VK-1002" Content="My vault appears missing" HorizontalAlignment="Stretch" Click="OpenAssistantQuickCase" />
                            <Button x:Name="AssistantQuickCase3" Grid.Row="1" Tag="VK-2004" Content="Cloud synchronization problem" HorizontalAlignment="Stretch" Click="OpenAssistantQuickCase" />
                            <Button x:Name="AssistantQuickCase4" Grid.Row="1" Grid.Column="1" Tag="VK-2005" Content="Virtual drive problem" HorizontalAlignment="Stretch" Click="OpenAssistantQuickCase" />
                        </Grid></StackPanel>

                        <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="20,17">
                            <StackPanel Spacing="14">
                                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="AssistantResultsTitle" Text="All diagnostic cases" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><Button x:Name="AssistantBackToCasesButton" Grid.Column="1" Content="‹  Back to Case List" HorizontalAlignment="Right" Visibility="Collapsed" Click="BackToAssistantCases" /></Grid>
                                <StackPanel x:Name="AssistantResultsPanel" Spacing="7" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource DeepSurfaceBrush}" CornerRadius="9" Padding="16,12"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE72E;" Foreground="{StaticResource BrandBlueBrush}" /><TextBlock Grid.Column="1" Text="This guide does not inspect vault contents, passwords, recovery keys, file names, or diagnostic logs." TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}" /></Grid></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <ScrollViewer x:Name="AddVaultView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AddVaultContent" MaxWidth="1120" Margin="42,34,42,50" HorizontalAlignment="Center" Spacing="22">
                    <StackPanel Spacing="5">
                        <TextBlock Text="How would you like to get started?" FontSize="27" FontWeight="SemiBold" />
                        <TextBlock Text="Create a new encrypted vault or connect one that already exists." Foreground="{StaticResource MutedTextBrush}" FontSize="15" TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid x:Name="AddVaultChoices" ColumnSpacing="18">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition x:Name="AddVaultChoiceColumn1" Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="CreateNewVaultButton" Grid.Column="0" Height="270" Padding="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="11" Click="ShowCreateVault" AutomationProperties.Name="Create a new vault">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource IconSurfaceBrush}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE710;" FontSize="25" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="10"><TextBlock Text="Create a new vault" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Set up a secure space for files on this computer or in your cloud storage." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="15" /></StackPanel>
                                <TextBlock Grid.Row="2" Text="Create vault  →" Foreground="{StaticResource BrandBlueBrush}" FontSize="15" />
                            </Grid>
                        </Button>
                        <Button x:Name="ConnectExistingVaultButton" Grid.Column="1" Height="270" Padding="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="11" Click="ShowConnectVault" AutomationProperties.Name="Connect an existing vault">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource IconSurfaceBrush}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE8B7;" FontSize="25" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Row="1" Margin="0,18,0,0" Spacing="10"><TextBlock Text="Connect an existing vault" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="Add a vault you created before, including one stored on another device." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="15" /></StackPanel>
                                <TextBlock Grid.Row="2" Text="Choose vault  →" Foreground="{StaticResource BrandBlueBrush}" FontSize="15" />
                            </Grid>
                        </Button>
                    </Grid>

                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20,16">
                        <Grid ColumnSpacing="14">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE777;" Foreground="{StaticResource BrandBlueBrush}" FontSize="21" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="Having trouble with a vault?" FontSize="17" /><TextBlock Text="Repair or recover access without creating another vault." Foreground="{StaticResource MutedTextBrush}" FontSize="12" /></StackPanel>
                            <Button x:Name="RepairRecoverButton" Grid.Column="2" Content="Repair or Recover" Padding="17,8" VerticalAlignment="Center" Click="ShowRecoveryHub" AutomationProperties.Name="Repair or recover a vault" />
                        </Grid>
                    </Border>
                    <Button Content="Back to Dashboard" HorizontalAlignment="Left" Padding="18,8" Click="ShowDashboard" AutomationProperties.Name="Back to Dashboard" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RecoveryHubView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="RecoveryHubContent" MaxWidth="1120" Margin="42,34,42,50" HorizontalAlignment="Center" Spacing="22">
                    <StackPanel Spacing="6">
                        <TextBlock Text="What would you like help with?" FontSize="29" FontWeight="SemiBold" />
                        <TextBlock Text="Choose the path that matches what happened. VaultKind keeps diagnosis separate from changes to your vault." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                    </StackPanel>
                    <Grid x:Name="RecoveryChoices" ColumnSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="RecoveryChoiceColumn2" Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="RecoveryPasswordButton" Grid.Column="0" MinHeight="245" Padding="22" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="11" Click="ShowRecoveryReset" AutomationProperties.Name="Restore password access with a recovery key">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource IconSurfaceBrush}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE8D7;" FontSize="24" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Row="1" Margin="0,17,0,0" Spacing="8"><TextBlock Text="Restore password access" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Use the recovery key saved when this vault was created to choose a new password." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="13" /></StackPanel>
                                <TextBlock Grid.Row="2" Text="Use recovery key  →" Foreground="{StaticResource BrandBlueBrush}" FontSize="14" />
                            </Grid>
                        </Button>
                        <Button x:Name="RecoveryReconnectButton" Grid.Column="1" MinHeight="245" Padding="22" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="11" Click="ShowConnectVault" AutomationProperties.Name="Reconnect an existing vault">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource IconSurfaceBrush}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Row="1" Margin="0,17,0,0" Spacing="8"><TextBlock Text="Reconnect a vault" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Add a vault back to VaultKind after its folder was moved or the app list was reset." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="13" /></StackPanel>
                                <TextBlock Grid.Row="2" Text="Choose vault folder  →" Foreground="{StaticResource BrandBlueBrush}" FontSize="14" />
                            </Grid>
                        </Button>
                        <Button x:Name="RecoveryDoctorButton" Grid.Column="2" MinHeight="245" Padding="22" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" CornerRadius="11" Click="ShowDoctor" AutomationProperties.Name="Inspect vault health with Vault Doctor">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Border Width="50" Height="50" CornerRadius="25" Background="{StaticResource IconSurfaceBrush}" HorizontalAlignment="Left"><FontIcon Glyph="&#xE9D9;" FontSize="24" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Row="1" Margin="0,17,0,0" Spacing="8"><TextBlock Text="Inspect vault health" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="Run private, read-only checks. Vault Doctor reports what it finds without repairing anything." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="13" /></StackPanel>
                                <TextBlock Grid.Row="2" Text="Open Vault Doctor  →" Foreground="{StaticResource BrandBlueBrush}" FontSize="14" />
                            </Grid>
                        </Button>
                    </Grid>
                    <Border Background="{StaticResource InfoSurfaceBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14">
                        <TextBlock Text="ⓘ  Recovery and diagnostic work stays on this computer. VaultKind does not upload your recovery key, passwords, or vault information." TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}" />
                    </Border>

                    <Button Content="Back to Add Vault" HorizontalAlignment="Left" Padding="18,8" Click="ShowAddVault" AutomationProperties.Name="Back to Add Vault" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RecoveryResetView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="820" Margin="42,30,42,50" HorizontalAlignment="Center" Spacing="18">
                    <StackPanel Spacing="6"><TextBlock Text="Restore password access" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="Confirm the recovery key that belongs to this vault, then choose a new password." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="14" /></StackPanel>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24,20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Locked vault" FontSize="14" />
                            <ComboBox x:Name="RecoveryVaultPicker" PlaceholderText="Choose a vault" HorizontalAlignment="Stretch" SelectionChanged="RecoveryFormChanged" AutomationProperties.Name="Vault to recover" />
                            <TextBlock Text="Recovery key" FontSize="14" Margin="0,6,0,0" />
                            <TextBox x:Name="RecoveryKeyInput" PlaceholderText="Paste every recovery-key word in its original order" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" TextChanged="RecoveryFormChanged" AutomationProperties.Name="Recovery key" />
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24,20">
                        <StackPanel Spacing="11">
                            <TextBlock Text="New vault password" FontSize="14" />
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><PasswordBox x:Name="RecoveryNewPassword" PlaceholderText="Use at least 8 characters" PasswordRevealMode="Hidden" PasswordChanged="RecoveryFormChanged" KeyDown="RecoveryPasswordKeyDown" AutomationProperties.Name="New vault password" /><Button Grid.Column="1" Width="46" Tag="RecoveryNewPassword" Click="TogglePasswordVisibility" AutomationProperties.Name="Show new vault password"><FontIcon Glyph="&#xE890;" /></Button></Grid>
                            <TextBlock Text="Confirm the new password" FontSize="14" Margin="0,6,0,0" />
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><PasswordBox x:Name="RecoveryConfirmPassword" PasswordRevealMode="Hidden" PasswordChanged="RecoveryFormChanged" KeyDown="RecoveryPasswordKeyDown" AutomationProperties.Name="Confirm new vault password" /><Button Grid.Column="1" Width="46" Tag="RecoveryConfirmPassword" Click="TogglePasswordVisibility" AutomationProperties.Name="Show confirmed vault password"><FontIcon Glyph="&#xE890;" /></Button></Grid>
                            <TextBlock x:Name="RecoveryPasswordStatus" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Border Background="#3B351A" BorderBrush="#C49B00" BorderThickness="1" CornerRadius="10" Padding="18,14"><TextBlock Text="⚠  VaultKind will create a backup of the current master-key file before changing the password. Your encrypted files are not rewritten." TextWrapping="Wrap" /></Border>
                    <CheckBox x:Name="RecoveryAcknowledge" Content="I understand that the recovery key must belong to the selected vault" Checked="RecoveryFormChanged" Unchecked="RecoveryFormChanged" />
                    <ProgressRing x:Name="RecoveryProgress" IsActive="False" Visibility="Collapsed" HorizontalAlignment="Left" AutomationProperties.Name="Password recovery in progress" />
                    <TextBlock x:Name="RecoveryStatus" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    <Grid><Button x:Name="RecoveryResetBackButton" Content="Back" Padding="28,9" Click="LeaveRecoveryReset" AutomationProperties.Name="Back to recovery choices" /><Button x:Name="RecoveryResetButton" Content="Reset Password" Padding="24,9" HorizontalAlignment="Right" IsEnabled="False" Background="#2B83E7" Foreground="White" Click="ResetVaultPassword" AutomationProperties.Name="Reset vault password" /></Grid>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ConnectVaultView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="900" Margin="42,30,42,42" HorizontalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="10">
                        <Grid><TextBlock Text="CONNECT A VAULT" Foreground="{StaticResource BrandBlueBrush}" FontSize="12" FontWeight="SemiBold" /><TextBlock x:Name="ConnectVaultStepText" Text="STEP 1 OF 2" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" /></Grid>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Height="4" Background="#2B83E7" CornerRadius="2" /><Border x:Name="ConnectVaultSecondStepBar" Grid.Column="1" Height="4" Background="{StaticResource TrackBrush}" CornerRadius="2" /></Grid>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,28,0,32" Spacing="20">
                        <StackPanel Spacing="6"><TextBlock Text="Connect an existing vault" FontSize="29" FontWeight="SemiBold" /><TextBlock Text="Choose the encrypted vault folder already stored on this computer, an external drive, or synchronized cloud storage." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="14" /></StackPanel>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24,20">
                            <Grid ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="26" Background="{StaticResource IconSurfaceBrush}"><FontIcon Glyph="&#xE8B7;" FontSize="24" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"><TextBlock Text="Select the vault folder" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="The folder normally contains vault.cryptomator and a d folder." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" FontSize="12" /></StackPanel>
                                <Button x:Name="ConnectVaultFolderButton" Grid.Column="2" Content="Choose folder..." Padding="18,9" VerticalAlignment="Center" Click="ChooseExistingVaultFolder" AutomationProperties.Name="Choose existing vault folder" />
                            </Grid>
                        </Border>
                        <Border x:Name="ConnectVaultReviewCard" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource InfoBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24,20">
                            <StackPanel Spacing="10"><TextBlock Text="Review your vault" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ConnectVaultNameText" Foreground="{StaticResource BrandBlueBrush}" FontSize="16" /><TextBlock x:Name="ConnectVaultPathText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" /><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="Configuration file" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="ConnectVaultConfigText" Grid.Column="1" FontWeight="SemiBold" TextWrapping="Wrap" /></Grid><TextBlock Text="Connecting this vault will not move, copy, rename, or change its encrypted files." TextWrapping="Wrap" Foreground="{StaticResource InfoTextBrush}" /></StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="10"><ProgressRing x:Name="ConnectVaultProgress" Width="20" Height="20" IsActive="False" Visibility="Collapsed" AutomationProperties.Name="Connecting vault" /><TextBlock x:Name="ConnectVaultStatus" Visibility="Collapsed" TextWrapping="Wrap" Foreground="#FF665D" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="2"><Button Content="Back" Padding="28,9" Click="ShowAddVault" AutomationProperties.Name="Back to Add Vault" /><Button x:Name="ConnectVaultButton" Content="Connect Vault" Padding="24,9" HorizontalAlignment="Right" IsEnabled="False" Background="#2B83E7" Foreground="White" Click="ConnectExistingVault" AutomationProperties.Name="Connect selected vault" /></Grid>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="CreateVaultView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="900" Margin="42,30,42,42" HorizontalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="CREATE A VAULT" Foreground="{StaticResource BrandBlueBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="STEP 1 OF 4" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="4" Background="#2B83E7" CornerRadius="2" />
                            <Border Grid.Column="1" Height="4" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                            <Border Grid.Column="2" Height="4" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                            <Border Grid.Column="3" Height="4" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,30,0,34" Spacing="20">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Name your vault" FontSize="29" FontWeight="SemiBold" />
                            <TextBlock Text="This name helps you recognize the vault in VaultKind. You can change it later." Foreground="{StaticResource MutedTextBrush}" FontSize="14" />
                        </StackPanel>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="26,22">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Vault name" FontSize="14" />
                                <TextBox x:Name="CreateVaultNameInput" PlaceholderText="For example: Personal files" FontSize="18" TextChanged="CreateVaultNameChanged" KeyDown="CreateVaultNameKeyDown" AutomationProperties.Name="Vault name" />
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="ⓘ  Use letters, numbers, spaces, hyphens, or underscores." Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" />
                                    <TextBlock x:Name="CreateVaultNameStatus" Grid.Column="1" Text="" HorizontalAlignment="Right" FontSize="13" FontWeight="SemiBold" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Button Content="Back" Padding="28,9" Click="ShowAddVault" AutomationProperties.Name="Back to Add Vault" />
                        <Button x:Name="CreateVaultNextButton" Content="Next" Padding="30,9" HorizontalAlignment="Right" IsEnabled="False" Background="#2B83E7" Foreground="White" Click="ShowCreateVaultStorage" AutomationProperties.Name="Continue to storage location" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="CreateVaultStorageView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="900" Margin="42,30,42,42" HorizontalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="CREATE A VAULT" Foreground="{StaticResource BrandBlueBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="STEP 2 OF 4" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="4" Background="#2B83E7" CornerRadius="2" />
                            <Border Grid.Column="1" Height="4" Background="#2B83E7" CornerRadius="2" />
                            <Border Grid.Column="2" Height="4" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                            <Border Grid.Column="3" Height="4" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,30,0,34" Spacing="18">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Choose where to store it" FontSize="29" FontWeight="SemiBold" />
                            <TextBlock Text="VaultKind encrypts your files before saving them here. Choose a local folder or one that syncs with your cloud service." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="26,22" MinHeight="150">
                            <StackPanel Spacing="18">
                                <TextBlock Text="Storage provider or folder" FontSize="14" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <RadioButton IsChecked="True" Content="Custom location" FontSize="18" VerticalAlignment="Center" IsTabStop="False" />
                                    <Button x:Name="CreateVaultStorageFolderButton" Padding="18,8" Click="ChooseCreateVaultFolder" AutomationProperties.Name="Choose storage folder">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE8B7;" />
                                            <TextBlock Text="Choose folder…" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Choose the parent folder. VaultKind will create a new folder inside it using your vault name." Foreground="{StaticResource MutedTextBrush}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Storage location" FontSize="14" />
                            <TextBox x:Name="CreateVaultStoragePath" IsReadOnly="True" PlaceholderText="Choose a folder to continue" FontSize="17" AutomationProperties.Name="Selected vault storage location" />
                            <TextBlock x:Name="CreateVaultStorageStatus" Text="" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Button Content="Back" Padding="28,9" Click="ReturnToCreateVaultName" AutomationProperties.Name="Back to vault name" />
                        <Button x:Name="CreateVaultStorageNextButton" Content="Next" Padding="30,9" HorizontalAlignment="Right" IsEnabled="False" Background="#2B83E7" Foreground="White" Click="ShowCreateVaultReview" AutomationProperties.Name="Continue to review" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="CreateVaultReviewView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="900" Margin="42,30,42,42" HorizontalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="CREATE A VAULT" Foreground="{StaticResource BrandBlueBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="STEP 3 OF 4" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="4" Background="#2B83E7" CornerRadius="2" />
                            <Border Grid.Column="1" Height="4" Background="#2B83E7" CornerRadius="2" />
                            <Border Grid.Column="2" Height="4" Background="#2B83E7" CornerRadius="2" />
                            <Border Grid.Column="3" Height="4" Background="{StaticResource TrackBrush}" CornerRadius="2" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,24,0,28" Spacing="14">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Review your vault" FontSize="29" FontWeight="SemiBold" />
                            <TextBlock Text="Check these details before choosing how your vault will be protected. Nothing has been created yet." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource IconSurfaceBrush}"><FontIcon Glyph="&#xE70F;" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Vault name" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                        <TextBlock x:Name="CreateVaultReviewName" Text="Vault" FontSize="17" />
                                    </StackPanel>
                                </Grid>
                                <Border Height="1" Background="{StaticResource CardBorderBrush}" />
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="19" Background="{StaticResource IconSurfaceBrush}"><FontIcon Glyph="&#xE7C3;" Foreground="{StaticResource BrandBlueBrush}" /></Border>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="Encrypted storage location" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                                        <TextBlock x:Name="CreateVaultReviewPath" Text="Storage location" FontSize="17" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <Border Background="{StaticResource DeepSurfaceBrush}" CornerRadius="8" Padding="14,11">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE946;" Foreground="{StaticResource BrandBlueBrush}" FontSize="15" VerticalAlignment="Top" Margin="0,3,0,0" />
                                        <TextBlock Grid.Column="1" Text="VaultKind will store encrypted data here. After setup, add and open your files through VaultKind—not directly inside this folder." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18,14">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Advanced compatibility" FontSize="13" />
                                <TextBlock Text="Most people should leave this off. Use it only when a storage provider or file system limits encrypted file-name length." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" />
                                <CheckBox x:Name="CreateVaultShortNamesOption" Content="Change encrypted file-name length" FontSize="16" AutomationProperties.Name="Change encrypted file-name length" Checked="CreateVaultShortNamesChanged" Unchecked="CreateVaultShortNamesChanged" />
                                <Border x:Name="CreateVaultShortNamesNotice" Visibility="Collapsed" Background="#26384A" BorderBrush="#2B83E7" BorderThickness="1" CornerRadius="8" Padding="12,9">
                                    <Grid ColumnSpacing="9">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE946;" Foreground="{StaticResource BrandBlueBrush}" FontSize="14" VerticalAlignment="Top" Margin="0,3,0,0" />
                                        <TextBlock Grid.Column="1" Text="Compatibility mode is on. VaultKind will use shorter encrypted file names for storage providers with stricter limits." Foreground="#C8DDF4" FontSize="13" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Button Content="Back" Padding="28,9" Click="ReturnToCreateVaultStorage" AutomationProperties.Name="Back to storage location" />
                        <Button x:Name="CreateVaultReviewNextButton" Content="Next" Padding="30,9" HorizontalAlignment="Right" Background="#2B83E7" Foreground="White" Click="ShowCreateVaultProtection" AutomationProperties.Name="Continue to vault protection" />
                    </Grid>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="CreateVaultProtectionView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="900" Margin="42,26,42,34" HorizontalAlignment="Center">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="CREATE A VAULT" Foreground="{StaticResource BrandBlueBrush}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="STEP 4 OF 4" HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="4" Background="#2B83E7" CornerRadius="2" />
                            <Border Grid.Column="1" Height="4" Background="#2B83E7" CornerRadius="2" />
                            <Border Grid.Column="2" Height="4" Background="#2B83E7" CornerRadius="2" />
                            <Border Grid.Column="3" Height="4" Background="#2B83E7" CornerRadius="2" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,20,0,22" Spacing="12">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Protect your vault" FontSize="29" FontWeight="SemiBold" />
                            <TextBlock Text="Choose a strong, memorable password. VaultKind cannot recover it for you." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22,16">
                            <StackPanel Spacing="11">
                                <TextBlock Text="Enter a new password" FontSize="16" />
