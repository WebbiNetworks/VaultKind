<?xml version="1.0" encoding="UTF-8"?>

<?import org.cryptomator.ui.controls.FontAwesome5IconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<HBox xmlns:fx="http://javafx.com/fxml"
	  xmlns="http://javafx.com/javafx"
	  fx:controller="org.cryptomator.ui.mainwindow.ActivityController"
	  styleClass="embedded-activity">
	<VBox minWidth="300" prefWidth="300" maxWidth="300" spacing="6" styleClass="preferences-navigation,embedded-preferences-navigation">
		<Button text="%main.home" onAction="#showDashboard" maxWidth="Infinity" alignment="CENTER_LEFT" styleClass="vault-home-button">
			<VBox.margin><Insets top="12" right="0" bottom="10" left="0"/></VBox.margin>
			<graphic><FontAwesome5IconView glyph="HOME" glyphSize="15"/></graphic>
		</Button>
		<Label text="%main.vaultlist.events" styleClass="preferences-navigation-title"/>
		<Label text="%eventView.pageDescription" wrapText="true" styleClass="preferences-navigation-subtitle"/>
		<Region VBox.vgrow="ALWAYS"/>
	</VBox>
	<VBox HBox.hgrow="ALWAYS" styleClass="preferences-content">
		<fx:include source="eventview.fxml" VBox.vgrow="ALWAYS"/>
	</VBox>
</HBox>
