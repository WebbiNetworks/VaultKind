<?xml version="1.0" encoding="UTF-8"?>

<?import org.cryptomator.ui.controls.FontAwesome5IconView?>
<?import org.cryptomator.ui.controls.NumericTextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
	  xmlns="http://javafx.com/javafx"
	  fx:controller="org.cryptomator.ui.addvaultwizard.CreateNewVaultExpertSettingsController"
	  prefWidth="820"
	  prefHeight="610"
	  spacing="10"
	  styleClass="add-vault-page"
	  accessibleRole="DIALOG">
	<padding>
		<Insets top="20" right="42" bottom="20" left="42"/>
	</padding>
	<children>
		<VBox spacing="9">
			<HBox alignment="CENTER_LEFT">
				<Label text="%addvaultwizard.new.progress.title" styleClass="add-vault-step-kicker"/>
				<Region HBox.hgrow="ALWAYS"/>
				<Label text="%addvaultwizard.new.progress.review" styleClass="add-vault-step-count"/>
			</HBox>
			<HBox spacing="7" styleClass="add-vault-progress">
				<Region styleClass="add-vault-progress-segment,add-vault-progress-current" HBox.hgrow="ALWAYS"/>
				<Region styleClass="add-vault-progress-segment,add-vault-progress-current" HBox.hgrow="ALWAYS"/>
				<Region styleClass="add-vault-progress-segment,add-vault-progress-current" HBox.hgrow="ALWAYS"/>
				<Region styleClass="add-vault-progress-segment" HBox.hgrow="ALWAYS"/>
			</HBox>
		</VBox>

		<VBox spacing="7">
			<Label text="%addvaultwizard.new.reviewTitle" styleClass="add-vault-page-title"/>
			<Label text="%addvaultwizard.new.reviewDescription" wrapText="true" styleClass="add-vault-page-description"/>
		</VBox>

		<VBox spacing="0" styleClass="add-vault-form-card,add-vault-review-card">
			<HBox alignment="CENTER_LEFT" spacing="14" styleClass="add-vault-review-row">
				<StackPane styleClass="add-vault-review-icon">
					<FontAwesome5IconView styleClass="glyph-icon-primary" glyph="PENCIL"/>
				</StackPane>
				<VBox spacing="3" HBox.hgrow="ALWAYS">
					<Label text="%addvaultwizard.new.reviewName" styleClass="add-vault-review-label"/>
					<Label fx:id="vaultNameLabel" wrapText="true" styleClass="add-vault-review-value"/>
				</VBox>
			</HBox>
			<Region styleClass="add-vault-review-divider"/>
			<HBox alignment="CENTER_LEFT" spacing="14" styleClass="add-vault-review-row">
				<StackPane styleClass="add-vault-review-icon">
					<FontAwesome5IconView styleClass="glyph-icon-primary" glyph="HDD"/>
				</StackPane>
				<VBox spacing="3" HBox.hgrow="ALWAYS">
					<Label text="%addvaultwizard.new.reviewLocation" styleClass="add-vault-review-label"/>
					<Label fx:id="vaultPathLabel" wrapText="true" styleClass="add-vault-review-value"/>
				</VBox>
			</HBox>
			<HBox alignment="TOP_LEFT" spacing="9" styleClass="add-vault-review-note">
				<FontAwesome5IconView glyph="INFO_CIRCLE" styleClass="glyph-icon-primary"/>
				<Label text="%addvaultwizard.new.reviewStorageNote" wrapText="true" maxWidth="Infinity" styleClass="label-muted" HBox.hgrow="ALWAYS"/>
			</HBox>
		</VBox>

		<VBox spacing="8" styleClass="add-vault-note">
			<Label text="%addvaultwizard.new.expertSettings.title" styleClass="add-vault-field-label"/>
			<Label text="%addvaultwizard.new.expertSettings.description" wrapText="true" maxWidth="Infinity" styleClass="label-muted"/>
			<CheckBox fx:id="expertSettingsCheckBox" text="%addvaultwizard.new.expertSettings.enableExpertSettingsCheckbox" onAction="#toggleUseExpertSettings"/>
			<VBox spacing="6" visible="${expertSettingsCheckBox.selected}" managed="${expertSettingsCheckBox.selected}">
				<Label text="%addvaultwizard.new.expertSettings.shorteningThreshold.title" labelFor="$shorteningThresholdTextField" styleClass="add-vault-field-label"/>
				<NumericTextField fx:id="shorteningThresholdTextField"/>
				<StackPane alignment="CENTER_RIGHT">
					<Label styleClass="label-muted" text="%addvaultwizard.new.expertSettings.shorteningThreshold.invalid" visible="${!controller.validShorteningThreshold}" managed="${!controller.validShorteningThreshold}" graphicTextGap="6">
						<graphic><FontAwesome5IconView styleClass="glyph-icon-red" glyph="TIMES"/></graphic>
					</Label>
					<Label styleClass="label-muted" text="%addvaultwizard.new.expertSettings.shorteningThreshold.valid" visible="${controller.validShorteningThreshold}" managed="${controller.validShorteningThreshold}" graphicTextGap="6">
						<graphic><FontAwesome5IconView styleClass="glyph-icon-primary" glyph="CHECK"/></graphic>
					</Label>
				</StackPane>
			</VBox>
		</VBox>

		<Region VBox.vgrow="ALWAYS"/>
		<ButtonBar buttonMinWidth="120" buttonOrder="B+X">
			<buttons>
				<Button text="%generic.button.back" ButtonBar.buttonData="BACK_PREVIOUS" onAction="#back"/>
				<Button text="%generic.button.next" ButtonBar.buttonData="NEXT_FORWARD" onAction="#next" defaultButton="true" disable="${!controller.validShorteningThreshold}"/>
			</buttons>
		</ButtonBar>
	</children>
</VBox>
