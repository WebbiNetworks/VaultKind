<?xml version="1.0" encoding="UTF-8"?>

<?import org.cryptomator.ui.controls.FontAwesome5IconView?>
<?import org.cryptomator.ui.controls.FontAwesome5Spinner?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
	  xmlns="http://javafx.com/javafx"
	  fx:controller="org.cryptomator.ui.addvaultwizard.CreateNewVaultLocationController"
	  prefWidth="820"
	  prefHeight="546"
	  spacing="16"
	  styleClass="add-vault-page"
	  accessibleRole="DIALOG">
	<fx:define>
		<ToggleGroup fx:id="locationPresetsToggler"/>
		<FontAwesome5IconView fx:id="badLocation" styleClass="glyph-icon-red" glyph="TIMES"/>
		<FontAwesome5IconView fx:id="goodLocation" styleClass="glyph-icon-success" glyph="CHECK"/>
	</fx:define>
	<padding>
		<Insets top="28" right="42" bottom="24" left="42"/>
	</padding>
	<children>
		<VBox spacing="9">
			<HBox alignment="CENTER_LEFT">
				<Label text="%addvaultwizard.new.progress.title" styleClass="add-vault-step-kicker"/>
				<Region HBox.hgrow="ALWAYS"/>
				<Label text="%addvaultwizard.new.progress.location" styleClass="add-vault-step-count"/>
			</HBox>
			<HBox spacing="7" styleClass="add-vault-progress">
				<Region styleClass="add-vault-progress-segment,add-vault-progress-current" HBox.hgrow="ALWAYS"/>
				<Region styleClass="add-vault-progress-segment,add-vault-progress-current" HBox.hgrow="ALWAYS"/>
				<Region styleClass="add-vault-progress-segment" HBox.hgrow="ALWAYS"/>
				<Region styleClass="add-vault-progress-segment" HBox.hgrow="ALWAYS"/>
			</HBox>
		</VBox>

		<VBox spacing="7">
			<Label text="%addvaultwizard.new.locationTitle" styleClass="add-vault-page-title"/>
			<Label text="%addvaultwizard.new.locationInstruction" wrapText="true" maxWidth="Infinity" styleClass="add-vault-page-description"/>
		</VBox>

		<VBox spacing="10" styleClass="add-vault-form-card" VBox.vgrow="ALWAYS">
			<HBox alignment="CENTER_LEFT">
				<Label text="%addvaultwizard.new.locationOptionsTitle" styleClass="add-vault-field-label" HBox.hgrow="ALWAYS"/>
				<Label text="%addvaultwizard.new.locationLoading" visible="${controller.loadingPresetLocations}" managed="${controller.loadingPresetLocations}" styleClass="label-muted" graphicTextGap="7">
					<graphic><FontAwesome5Spinner/></graphic>
				</Label>
			</HBox>
			<ScrollPane hbarPolicy="NEVER" fitToWidth="true" styleClass="add-vault-location-list" VBox.vgrow="ALWAYS">
				<VBox fx:id="radioButtonVBox" spacing="10">
					<HBox fx:id="customLocationRadioBtn" spacing="12" alignment="CENTER_LEFT" styleClass="add-vault-location-row">
						<RadioButton fx:id="customRadioButton" toggleGroup="${locationPresetsToggler}" text="%addvaultwizard.new.directoryPickerLabel" HBox.hgrow="ALWAYS"/>
						<Button contentDisplay="LEFT" text="%addvaultwizard.new.directoryPickerButton" onAction="#chooseCustomVaultPath" disable="${controller.usePresetPath}">
							<graphic><FontAwesome5IconView glyph="FOLDER_OPEN"/></graphic>
						</Button>
					</HBox>
				</VBox>
			</ScrollPane>
		</VBox>

		<VBox spacing="7">
			<Label text="%addvaultwizard.new.locationLabel" labelFor="$locationTextField" styleClass="add-vault-field-label"/>
			<TextField fx:id="locationTextField" promptText="%addvaultwizard.new.locationPrompt" text="${controller.vaultPath}" editable="false" disable="${!controller.anyRadioButtonSelected}" prefHeight="42"/>
			<Label fx:id="locationStatusLabel" alignment="CENTER_RIGHT" wrapText="true" visible="${controller.anyRadioButtonSelected}" maxWidth="Infinity" graphicTextGap="6"/>
		</VBox>

		<ButtonBar buttonMinWidth="120" buttonOrder="B+X">
			<buttons>
				<Button text="%generic.button.back" ButtonBar.buttonData="BACK_PREVIOUS" onAction="#back"/>
				<Button text="%generic.button.next" ButtonBar.buttonData="NEXT_FORWARD" onAction="#next" defaultButton="true" disable="${!controller.validVaultPath}"/>
			</buttons>
		</ButtonBar>
	</children>
</VBox>
