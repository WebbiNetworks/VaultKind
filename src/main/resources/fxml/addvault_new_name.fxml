<?xml version="1.0" encoding="UTF-8"?>

<?import org.cryptomator.ui.controls.FontAwesome5IconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
	  xmlns="http://javafx.com/javafx"
	  fx:controller="org.cryptomator.ui.addvaultwizard.CreateNewVaultNameController"
	  prefWidth="820"
	  prefHeight="546"
	  spacing="26"
	  styleClass="add-vault-page"
	  accessibleRole="DIALOG">
	<padding>
		<Insets top="38" right="42" bottom="28" left="42"/>
	</padding>
	<children>
		<VBox spacing="9">
			<HBox alignment="CENTER_LEFT">
				<Label text="%addvaultwizard.new.progress.title" styleClass="add-vault-step-kicker"/>
				<Region HBox.hgrow="ALWAYS"/>
				<Label text="%addvaultwizard.new.progress.name" styleClass="add-vault-step-count"/>
			</HBox>
			<HBox spacing="7" styleClass="add-vault-progress">
				<Region styleClass="add-vault-progress-segment,add-vault-progress-current" HBox.hgrow="ALWAYS"/>
				<Region styleClass="add-vault-progress-segment" HBox.hgrow="ALWAYS"/>
				<Region styleClass="add-vault-progress-segment" HBox.hgrow="ALWAYS"/>
				<Region styleClass="add-vault-progress-segment" HBox.hgrow="ALWAYS"/>
			</HBox>
		</VBox>

		<VBox spacing="7">
			<Label text="%addvaultwizard.new.nameTitle" styleClass="add-vault-page-title"/>
			<Label text="%addvaultwizard.new.nameDescription" wrapText="true" styleClass="add-vault-page-description"/>
		</VBox>

		<VBox spacing="12" styleClass="add-vault-form-card">
			<Label text="%addvaultwizard.new.nameInstruction" labelFor="$textField" styleClass="add-vault-field-label"/>
			<TextField fx:id="textField" promptText="%addvaultwizard.new.namePrompt" prefHeight="44"/>
			<HBox alignment="CENTER_LEFT" spacing="7">
				<FontAwesome5IconView glyph="INFO_CIRCLE" glyphSize="13" styleClass="glyph-icon-muted"/>
				<Label text="%addvaultwizard.new.validCharacters.simple" wrapText="true" styleClass="label-muted" HBox.hgrow="ALWAYS"/>
				<StackPane visible="${!textField.text.empty}" managed="${!textField.text.empty}">
					<Label text="%addvaultwizard.new.invalidName" visible="${!controller.validVaultName}" styleClass="label-red" graphicTextGap="6">
						<graphic><FontAwesome5IconView styleClass="glyph-icon-red" glyph="TIMES"/></graphic>
					</Label>
					<Label text="%addvaultwizard.new.validName" visible="${controller.validVaultName}" styleClass="label-muted" graphicTextGap="6">
						<graphic><FontAwesome5IconView styleClass="glyph-icon-primary" glyph="CHECK"/></graphic>
					</Label>
				</StackPane>
			</HBox>
		</VBox>

		<Region VBox.vgrow="ALWAYS"/>

		<ButtonBar buttonMinWidth="120" buttonOrder="B+X">
			<buttons>
				<Button text="%generic.button.back" ButtonBar.buttonData="BACK_PREVIOUS" onAction="#back"/>
				<Button text="%generic.button.next" ButtonBar.buttonData="NEXT_FORWARD" onAction="#next" defaultButton="true" disable="${!controller.validVaultName}"/>
			</buttons>
		</ButtonBar>
	</children>
</VBox>
