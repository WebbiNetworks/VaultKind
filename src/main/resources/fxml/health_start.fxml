<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.cryptomator.ui.controls.FontAwesome5IconView?>

<VBox xmlns:fx="http://javafx.com/fxml"
	  xmlns="http://javafx.com/javafx"
	  fx:controller="org.cryptomator.ui.health.StartController"
	  maxWidth="900" spacing="20" styleClass="health-workspace">
	<padding><Insets top="28" right="32" bottom="28" left="32"/></padding>
	<children>
		<HBox spacing="14" alignment="CENTER_LEFT">
			<VBox alignment="CENTER" styleClass="health-icon-tile">
				<FontAwesome5IconView glyph="STETHOSCOPE" glyphSize="24" styleClass="glyph-icon-primary"/>
			</VBox>
			<VBox spacing="4">
				<Label text="%health.intro.header" styleClass="health-heading"/>
				<Label text="%health.workspace.intro" wrapText="true" styleClass="health-description"/>
			</VBox>
		</HBox>

		<VBox spacing="12" styleClass="health-intro-card">
			<Label text="%health.workspace.beforeHeading" styleClass="health-section-title"/>
			<Label text="%health.intro.text" wrapText="true" styleClass="health-description"/>
			<HBox spacing="12" alignment="TOP_LEFT" styleClass="health-guidance-row">
				<Label text="1" styleClass="health-number-badge"/>
				<VBox spacing="3" HBox.hgrow="ALWAYS">
					<Label text="%health.workspace.syncHeading" styleClass="health-guidance-title"/>
					<Label text="%health.intro.remarkSync" wrapText="true" styleClass="label-muted"/>
				</VBox>
			</HBox>
			<HBox spacing="12" alignment="TOP_LEFT" styleClass="health-guidance-row">
				<Label text="2" styleClass="health-number-badge"/>
				<VBox spacing="3" HBox.hgrow="ALWAYS">
					<Label text="%health.workspace.fixHeading" styleClass="health-guidance-title"/>
					<Label text="%health.intro.remarkFix" wrapText="true" styleClass="label-muted"/>
				</VBox>
			</HBox>
			<HBox spacing="12" alignment="TOP_LEFT" styleClass="health-guidance-row">
				<Label text="3" styleClass="health-number-badge"/>
				<VBox spacing="3" HBox.hgrow="ALWAYS">
					<Label text="%health.workspace.backupHeading" styleClass="health-guidance-title"/>
					<Label text="%health.intro.remarkBackup" wrapText="true" styleClass="label-muted"/>
				</VBox>
			</HBox>
		</VBox>

		<CheckBox text="%health.intro.affirmation" fx:id="affirmationBox" wrapText="true" styleClass="health-affirmation"/>
		<Region VBox.vgrow="ALWAYS"/>
		<ButtonBar buttonMinWidth="130" buttonOrder="+CX">
			<buttons>
				<Button text="%generic.button.cancel" ButtonBar.buttonData="CANCEL_CLOSE" cancelButton="true" onAction="#close" styleClass="health-secondary"/>
				<Button text="%health.workspace.continue" ButtonBar.buttonData="NEXT_FORWARD" disable="${!affirmationBox.selected}" defaultButton="true" onAction="#next" styleClass="health-primary"/>
			</buttons>
		</ButtonBar>
	</children>
</VBox>
