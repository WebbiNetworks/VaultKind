<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<ScrollPane xmlns:fx="http://javafx.com/fxml"
			xmlns="http://javafx.com/javafx"
			fx:controller="org.cryptomator.ui.preferences.GeneralPreferencesController"
			fitToWidth="true"
			hbarPolicy="NEVER"
			styleClass="preferences-page-scroll">
	<content>
		<VBox spacing="24" styleClass="preferences-page">
			<VBox spacing="6">
				<Label text="%preferences.general.pageTitle" styleClass="preferences-page-title"/>
				<Label text="%preferences.general.pageDescription" wrapText="true" styleClass="preferences-page-description"/>
			</VBox>
			<VBox spacing="2" styleClass="settings-card">
				<Label text="%preferences.general.group.startup" styleClass="settings-section-title"/>
				<CheckBox fx:id="autoStartCheckbox" text="%preferences.general.autoStart" visible="${controller.autoStartSupported}" managed="${controller.autoStartSupported}" onAction="#toggleAutoStart" styleClass="settings-row"/>
				<CheckBox fx:id="startHiddenCheckbox" text="%preferences.general.startHidden" styleClass="settings-row"/>
				<CheckBox fx:id="autoCloseVaultsCheckbox" text="%preferences.general.autoCloseVaults" styleClass="settings-row"/>
			</VBox>
			<VBox spacing="4" styleClass="settings-card">
				<Label text="%preferences.general.group.integration" styleClass="settings-section-title"/>
				<HBox spacing="12" alignment="CENTER_LEFT" styleClass="settings-row">
					<CheckBox fx:id="useKeychainCheckbox" text="%preferences.general.keychainBackend" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
					<Region HBox.hgrow="ALWAYS"/>
					<ChoiceBox fx:id="keychainBackendChoiceBox" accessibleText="%preferences.general.keychainBackend" minWidth="190" prefWidth="210" maxWidth="210"/>
				</HBox>
				<HBox spacing="12" alignment="CENTER_LEFT" visible="${controller.someQuickAccessServiceAvailable}" managed="${controller.someQuickAccessServiceAvailable}" styleClass="settings-row">
					<CheckBox fx:id="useQuickAccessCheckbox" text="%preferences.general.quickAccessService" wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
					<Region HBox.hgrow="ALWAYS"/>
					<ChoiceBox fx:id="quickAccessServiceChoiceBox" accessibleText="%preferences.general.quickAccessService" minWidth="190" prefWidth="210" maxWidth="210"/>
				</HBox>
				<Button fx:id="resetTrustedHostsButton" text="%preferences.general.resetTrustedHosts" visible="${controller.hubTrustOnFirstUseEnabled}" managed="${controller.hubTrustOnFirstUseEnabled}" onAction="#resetTrustedHosts"/>
			</VBox>
			<VBox spacing="4" styleClass="settings-card">
				<Label text="%preferences.general.group.diagnostics" styleClass="settings-section-title"/>
				<HBox spacing="12" alignment="CENTER_LEFT" styleClass="settings-row">
					<CheckBox fx:id="debugModeCheckbox" text="%preferences.general.debugLogging"/>
					<Region HBox.hgrow="ALWAYS"/>
					<Hyperlink styleClass="hyperlink-underline" text="%preferences.general.debugDirectory" onAction="#showLogfileDirectory"/>
				</HBox>
			</VBox>
		</VBox>
	</content>
</ScrollPane>
