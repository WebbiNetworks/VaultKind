<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.cryptomator.ui.controls.FontAwesome5IconView?>

<VBox xmlns:fx="http://javafx.com/fxml"
	  xmlns="http://javafx.com/javafx"
	  fx:controller="org.cryptomator.ui.recoverykey.RecoveryKeyRecoverController"
	  spacing="18" maxWidth="900" alignment="TOP_LEFT"
	  styleClass="recovery-key-workspace">
	<padding>
		<Insets top="28" right="32" bottom="28" left="32"/>
	</padding>
	<children>
		<HBox alignment="CENTER_LEFT" spacing="14">
			<VBox styleClass="recovery-key-icon-tile" alignment="CENTER">
				<FontAwesome5IconView glyph="KEY" glyphSize="24" styleClass="glyph-icon-primary"/>
			</VBox>
			<VBox spacing="4">
				<Label text="%recoveryKey.reset.keyHeading" styleClass="recovery-key-heading"/>
				<Label text="%recoveryKey.reset.keyIntro" wrapText="true" styleClass="recovery-key-description"/>
			</VBox>
		</HBox>

		<HBox spacing="8">
			<Region HBox.hgrow="ALWAYS" styleClass="recovery-key-step-active"/>
			<Region HBox.hgrow="ALWAYS" styleClass="recovery-key-step-inactive"/>
		</HBox>
		<HBox alignment="CENTER_LEFT">
			<Label text="%recoveryKey.reset.step1" styleClass="recovery-key-step-label"/>
			<Region HBox.hgrow="ALWAYS"/>
			<Label text="%recoveryKey.reset.stepCount1" styleClass="label-muted"/>
		</HBox>

		<VBox spacing="12" styleClass="recovery-key-display-card">
			<fx:include fx:id="recoveryKeyValidate" source="recoverykey_validate.fxml"/>
		</VBox>

		<HBox alignment="CENTER_LEFT" spacing="10" styleClass="recovery-key-privacy-note">
			<FontAwesome5IconView glyph="LOCK" styleClass="glyph-icon-primary"/>
			<Label text="%recoveryKey.reset.localNote" wrapText="true" HBox.hgrow="ALWAYS"/>
		</HBox>

		<Region VBox.vgrow="ALWAYS"/>
		<ButtonBar buttonMinWidth="130" buttonOrder="+BX">
			<buttons>
				<Button fx:id="cancelButton" ButtonBar.buttonData="BACK_PREVIOUS" cancelButton="true" onAction="#closeOrReturn" styleClass="recovery-key-secondary"/>
				<Button text="%generic.button.next" ButtonBar.buttonData="NEXT_FORWARD" defaultButton="true" onAction="#recover" disable="${!controller.validateController.recoveryKeyCorrect}" styleClass="recovery-key-primary"/>
			</buttons>
		</ButtonBar>
	</children>
</VBox>
