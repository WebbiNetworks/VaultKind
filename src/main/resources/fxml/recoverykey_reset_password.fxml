<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.cryptomator.ui.controls.FontAwesome5IconView?>

<StackPane xmlns:fx="http://javafx.com/fxml"
	  xmlns="http://javafx.com/javafx"
	  fx:controller="org.cryptomator.ui.recoverykey.RecoveryKeyResetPasswordController"
	  maxWidth="900" styleClass="recovery-key-workspace">
	<children>
		<VBox spacing="18" alignment="TOP_LEFT" visible="${!controller.resetSucceeded}" managed="${!controller.resetSucceeded}">
			<padding><Insets top="28" right="32" bottom="28" left="32"/></padding>
			<HBox alignment="CENTER_LEFT" spacing="14">
				<VBox styleClass="recovery-key-icon-tile" alignment="CENTER">
					<FontAwesome5IconView glyph="KEY" glyphSize="24" styleClass="glyph-icon-primary"/>
				</VBox>
				<VBox spacing="4">
					<Label text="%recoveryKey.reset.passwordHeading" styleClass="recovery-key-heading"/>
					<Label text="%recoveryKey.reset.passwordIntro" wrapText="true" styleClass="recovery-key-description"/>
				</VBox>
			</HBox>

			<HBox spacing="8">
				<Region HBox.hgrow="ALWAYS" styleClass="recovery-key-step-complete"/>
				<Region HBox.hgrow="ALWAYS" styleClass="recovery-key-step-active"/>
			</HBox>
			<HBox alignment="CENTER_LEFT">
				<Label text="%recoveryKey.reset.step2" styleClass="recovery-key-step-label"/>
				<Region HBox.hgrow="ALWAYS"/>
				<Label text="%recoveryKey.reset.stepCount2" styleClass="label-muted"/>
			</HBox>

			<VBox spacing="14" styleClass="recovery-key-password-card">
				<fx:include fx:id="newPassword" source="new_password.fxml"/>
			</VBox>

			<HBox spacing="8" alignment="CENTER_LEFT" visible="${!controller.operationError.empty}" managed="${!controller.operationError.empty}" styleClass="recovery-key-inline-error">
				<FontAwesome5IconView glyph="EXCLAMATION_CIRCLE" styleClass="glyph-icon-red"/>
				<Label text="${controller.operationError}" wrapText="true" HBox.hgrow="ALWAYS"/>
			</HBox>

			<HBox alignment="CENTER_LEFT" spacing="10" styleClass="recovery-key-warning-card">
				<FontAwesome5IconView glyph="EXCLAMATION_TRIANGLE" styleClass="glyph-icon-orange"/>
				<Label text="%recoveryKey.reset.warning" wrapText="true" HBox.hgrow="ALWAYS"/>
			</HBox>

			<Region VBox.vgrow="ALWAYS"/>
			<ButtonBar buttonMinWidth="130" buttonOrder="+CI">
				<buttons>
					<Button text="%generic.button.back" ButtonBar.buttonData="CANCEL_CLOSE" cancelButton="true" onAction="#close" disable="${controller.processing}" styleClass="recovery-key-secondary"/>
					<Button fx:id="nextButton" ButtonBar.buttonData="FINISH" defaultButton="true" disable="${(!controller.passwordSufficientAndMatching) || controller.processing}" onAction="#next" styleClass="recovery-key-primary"/>
				</buttons>
			</ButtonBar>
			<ProgressIndicator maxWidth="24" maxHeight="24" visible="${controller.processing}" managed="${controller.processing}"/>
		</VBox>

		<VBox spacing="18" alignment="CENTER" visible="${controller.resetSucceeded}" managed="${controller.resetSucceeded}" styleClass="recovery-key-success-pane">
			<FontAwesome5IconView glyph="CHECK" glyphSize="64" styleClass="glyph-icon-success"/>
			<Label text="%recoveryKey.reset.successHeading" styleClass="recovery-key-heading"/>
			<Label text="%recoveryKey.recover.resetSuccess.description" wrapText="true" textAlignment="CENTER" styleClass="recovery-key-description"/>
			<Button text="%recoveryKey.display.done" defaultButton="true" onAction="#done" minWidth="150" styleClass="recovery-key-primary"/>
		</VBox>
	</children>
</StackPane>
