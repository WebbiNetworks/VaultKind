<?xml version="1.0" encoding="UTF-8"?>
<configuration>
	<property name="LOG_DIR" value="${cryptomator.logDir:-.}"/>

	<appender name="NATIVE_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_DIR}/native-backend.log</file>
		<rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
			<fileNamePattern>${LOG_DIR}/native-backend.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
			<maxFileSize>5MB</maxFileSize>
			<maxHistory>7</maxHistory>
			<totalSizeCap>25MB</totalSizeCap>
		</rollingPolicy>
		<encoder>
			<pattern>%date{HH:mm:ss.SSS} [%thread] %-5level %logger{40} - %message%n</pattern>
		</encoder>
	</appender>

	<root level="INFO">
		<appender-ref ref="NATIVE_FILE"/>
	</root>
</configuration>
